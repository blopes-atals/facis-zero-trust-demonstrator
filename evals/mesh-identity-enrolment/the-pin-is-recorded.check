#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The pin is recorded
# level: L1
# requirement: Istio is installed in sidecar mode as pinned upstream releases with SPIRE as the certificate source
. "$(dirname "$0")/../lib.sh"
f=$REPO/docs/dependencies.md
row=$(grep -i '^|.*istio' "$f" | grep -iv 'istioctl' | grep -i 'base' | head -1)
echo "Istio row: $row"
[ -n "$row" ] || { echo "FAIL: no Istio row naming its charts in docs/dependencies.md"; exit 1; }
ver=$(grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+' <<<"$row" | head -1)
pin=$(sed -n 's/^ISTIO_VERSION=//p' "$INSTALL")
rc=0
[ -n "$ver" ] && echo "version named: $ver" || { echo "FAIL: no version in the row"; rc=1; }
[ "$ver" = "$pin" ] || { echo "FAIL: version $ver differs from the installer pin $pin"; rc=1; }
for c in base istiod cni; do grep -q "\`$c\`\|\b$c\b" <<<"$row" || { echo "FAIL: chart $c not named"; rc=1; }; done
grep -qi 'sidecar' <<<"$row" && echo "mode named: sidecar" || { echo "FAIL: mode (sidecar) not named"; rc=1; }
exit $rc
