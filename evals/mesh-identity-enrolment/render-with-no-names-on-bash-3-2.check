#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Render with no names on bash 3.2
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
# Needs bash 3.2: EVAL_BASH32=/path/to/bash, `bash3.2` / `bash-3.2` on PATH, or
# EVAL_BASH32_IMAGE=bash:3.2 to run in that container (docker, or `sg docker` when this session
# predates the docker group). The container gets the repo read-only, the host helm and a copy of
# the chart cache; it installs python3, py3-yaml and curl with apk.
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
cache_copy; mkdir -p "$EVAL_TMP/render"
B=${EVAL_BASH32:-$(command -v bash3.2 || command -v bash-3.2 || true)}
if [ -n "$B" ] && "$B" --version 2>/dev/null | head -1 | grep -q 'version 3\.2'; then
  ( cd "$EVAL_ROOT" && env -u CI INSTALL_ZONE_CACHE="$EVAL_TMP/cache" RENDER_DIR="$EVAL_TMP/render" \
      "$B" scripts/install-zone/install.sh render >"$EVAL_TMP/out" 2>"$EVAL_TMP/err" )
  rc=$?
elif [ -n "${EVAL_BASH32_IMAGE:-}" ]; then
  # the real checkout (EVAL_ROOT may be a tree of symlinks, which a bind mount does not follow)
  ROOT=$(dirname "$(cd "$EVAL_ROOT/scripts" && pwd -P)")
  helm_bin=$(command -v helm) || { echo "UNVERIFIABLE: helm not installed"; exit 77; }
  if docker info >/dev/null 2>&1; then dk() { bash "$@"; }
  elif command -v sg >/dev/null && sg docker -c 'docker info' >/dev/null 2>&1; then dk() { sg docker -c "bash $*"; }
  else echo "UNVERIFIABLE: EVAL_BASH32_IMAGE set but Docker is not reachable"; exit 77; fi
  cat >"$EVAL_TMP/inner.sh" <<'IN'
set -u
apk add -q --no-cache python3 py3-yaml curl jq >/dev/null 2>&1 || { echo "apk add failed" >&2; exit 90; }
bash --version | head -1 >&2
cd "$EVAL_ROOT" && env -u CI HOME=/tmp INSTALL_ZONE_CACHE="$EVAL_TMP/cache" RENDER_DIR="$EVAL_TMP/render" \
  bash scripts/install-zone/install.sh render >"$EVAL_TMP/out" 2>"$EVAL_TMP/err"
rc=$?; chown -R "$OWNER" "$EVAL_TMP/cache" "$EVAL_TMP/render" "$EVAL_TMP/out" "$EVAL_TMP/err" 2>/dev/null; exit $rc
IN
  cat >"$EVAL_TMP/outer.sh" <<OUT
exec docker run --rm -e EVAL_ROOT="$ROOT" -e EVAL_TMP="$EVAL_TMP" -e OWNER="$(id -u):$(id -g)" \
  -v "$ROOT:$ROOT:ro" -v "$EVAL_TMP:$EVAL_TMP" -v "$helm_bin:/usr/local/bin/helm:ro" \
  "$EVAL_BASH32_IMAGE" bash "$EVAL_TMP/inner.sh"
OUT
  dk "$EVAL_TMP/outer.sh" 2>"$EVAL_TMP/docker.err"; rc=$?
  cat "$EVAL_TMP/docker.err"
  [ $rc -eq 90 ] && { echo "UNVERIFIABLE: could not install python3/py3-yaml/curl in $EVAL_BASH32_IMAGE"; exit 77; }
  grep -q 'version 3\.2' "$EVAL_TMP/docker.err" || { echo "UNVERIFIABLE: $EVAL_BASH32_IMAGE does not run bash 3.2"; exit 77; }
else
  echo "UNVERIFIABLE: no bash 3.2 binary on this host (set EVAL_BASH32, or EVAL_BASH32_IMAGE=bash:3.2); host bash is $BASH_VERSION, where an empty array under set -u does not fail, so the scenario cannot be reproduced with it"
  exit 77
fi
cat "$EVAL_TMP/out" "$EVAL_TMP/err" 2>/dev/null
fail=0
[ $rc -eq 0 ] || { echo "FAIL: exit $rc"; fail=1; }
grep -qi 'unbound variable' "$EVAL_TMP/err" && { echo "FAIL: unbound variable error raised"; fail=1; }
for r in $SEVEN; do [ -s "$EVAL_TMP/render/$r.yaml" ] || { echo "FAIL: $r not rendered"; fail=1; }; done
[ $fail -eq 0 ] && echo "PASS: every release rendered under bash 3.2, no unbound-variable error"
exit $fail
