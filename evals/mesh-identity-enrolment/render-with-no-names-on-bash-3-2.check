#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Render with no names on bash 3.2
# level: L1
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/lib.sh"
b32=
for c in /bin/bash3 /usr/local/bin/bash3.2 /opt/homebrew/bin/bash32 /bin/bash-3.2; do [ -x "$c" ] && b32=$c && break; done
bash=${b32:-bash}
echo "shell: $bash ($("$bash" -c 'echo $BASH_VERSION'))"
cache; rm -rf "$EVAL_TMP/out"; mkdir -p "$EVAL_TMP/out"
out=$(ZONE_VALUES=$KIND_ZONE RENDER_DIR=$EVAL_TMP/out "$bash" "$INSTALL" render 2>&1); rc=$?
echo "$out" | tail -10
[ $rc -eq 0 ] || { echo "expected exit 0, got $rc"; exit 1; }
grep -qi 'unbound variable' <<<"$out" && { echo "unbound variable error"; exit 1; }
n=$(ls "$EVAL_TMP/out" | wc -l); [ "$n" -eq 8 ] || { echo "expected 8 releases rendered, got $n"; exit 1; }
[ -n "$b32" ] || echo "note: no bash 3.2 on this host; ran the installer's bash with set -u semantics only"
