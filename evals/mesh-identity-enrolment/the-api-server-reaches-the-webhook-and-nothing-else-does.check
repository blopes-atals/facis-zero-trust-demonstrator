#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The API server reaches the webhook and nothing else does
# level: L2
# requirement: The mesh control plane is a management-plane namespace with declared openings
. "$(dirname "$0")/../lib.sh"
need_live
probe_control
rc=0
inj=$(k -n "$DATA" get pod ev-client -o json | jq -r '[(.spec.initContainers // [])[].name, .spec.containers[].name] | join(",")')
echo "ev-client (created in $DATA) containers: $inj"
grep -q istio-proxy <<<"$inj" && echo "PASS: the pod is injected (the API server reached istiod's webhook)" || { echo "FAIL: not injected"; rc=1; }
pod=$(k -n "$ISTIO_NS" get pod -l app=istiod -o jsonpath='{.items[0].metadata.name}'); ip=$(k -n "$ISTIO_NS" get pod "$pod" -o jsonpath='{.status.podIP}')
ports=$( { pod_ports "$ISTIO_NS" "$pod"; printf '%s\n' 80 443 8080 9876 15010 15014 15017 15021; } | sort -un | grep -vx 15012)
echo "probing istiod $ip from $DATA/ev-probe (no sidecar) on: $(echo $ports)"
for p in $ports; do r=$(tcp_probe "$DATA" ev-probe app "$ip" "$p"); echo "  :$p $r"; [ "$r" = dropped ] || rc=1; done
[ $rc -eq 0 ] && echo "PASS: every non-xDS port denied" || echo "FAIL: see above"
exit $rc
