#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Render from the pinned charts
# level: L1
# requirement: The Istio values render in CI with the CNI plugin chained and a STRICT mesh-wide policy
. "$(dirname "$0")/../lib.sh"
render_all "$EVAL_TMP/r" || { echo "FAIL: install.sh render failed"; tail -20 "$EVAL_TMP/r.log"; exit 1; }
helm template zone-policy "$REPO/deployment/helm/zone-policy" -n istio-system \
  -f "$REPO/deployment/helm/zone-policy/ci/values.yaml" > "$EVAL_TMP/zp.yaml" 2>&1 \
  || { echo "FAIL: zone-policy does not render from its ci/values.yaml"; cat "$EVAL_TMP/zp.yaml"; exit 1; }
python3 - "$EVAL_TMP/r" "$EVAL_TMP/zp.yaml" "$KIND_ZONE" <<'PY'
import sys, yaml, json
d, zp, zone = sys.argv[1:]
td = yaml.safe_load(open(zone))["zone"]["trustDomain"]
load = lambda p: [x for x in yaml.safe_load_all(open(p)) if x]
istiod, cni, pol = load(f"{d}/istiod.yaml"), load(f"{d}/istio-cni.yaml"), load(zp)
fails = []
def ok(c, msg):
    print(("PASS: " if c else "FAIL: ") + msg)
    if not c: fails.append(msg)
dep = [x for x in istiod if x["kind"] == "Deployment" and x["metadata"]["name"] == "istiod"]
env = {e["name"]: e.get("value") for c in dep[0]["spec"]["template"]["spec"]["containers"] for e in c.get("env", [])} if dep else {}
ok(env.get("ENABLE_NATIVE_SIDECARS") == "true", f"istiod ENABLE_NATIVE_SIDECARS={env.get('ENABLE_NATIVE_SIDECARS')!r} (want 'true')")
mesh = [x for x in istiod if x["kind"] == "ConfigMap" and x["metadata"]["name"] == "istio"]
meshcfg = yaml.safe_load(mesh[0]["data"]["mesh"]) if mesh else {}
ok(meshcfg.get("trustDomain") == td, f"mesh trustDomain={meshcfg.get('trustDomain')!r} (zone: {td!r})")
inj = [x for x in istiod if x["kind"] == "ConfigMap" and x["metadata"]["name"].startswith("istio-sidecar-injector")]
cfg = yaml.safe_load(inj[0]["data"]["config"]) if inj else {}
ok("spire" in (cfg.get("templates") or {}), f"injector templates: {sorted((cfg.get('templates') or {}).keys())}")
ok("spire" in (cfg.get("defaultTemplates") or []), f"injector defaultTemplates: {cfg.get('defaultTemplates')}")
cm = [x for x in cni if x["kind"] == "ConfigMap"]
chained = [x["data"].get("CHAINED_CNI_PLUGIN") for x in cm if "CHAINED_CNI_PLUGIN" in (x.get("data") or {})]
ok(chained == ["true"], f"CNI CHAINED_CNI_PLUGIN={chained}")
pa = [x for x in pol if x["kind"] == "PeerAuthentication" and x["metadata"]["name"] == "default"]
ok(len(pa) == 1 and pa[0]["spec"].get("mtls", {}).get("mode") == "STRICT" and not pa[0]["spec"].get("selector"),
   f"PeerAuthentication default: {json.dumps([p['spec'] for p in pa])} in {[p['metadata'].get('namespace') for p in pa]}")
sys.exit(1 if fails else 0)
PY
