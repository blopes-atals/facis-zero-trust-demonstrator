#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The render carries the minimum
# level: L1
# requirement: The mesh enforces TLS 1.3 as the minimum for mesh mTLS
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
command -v helm >/dev/null || { echo "UNVERIFIABLE: helm not installed"; exit 77; }
cache_copy; mkdir -p "$EVAL_TMP/render"
( cd "$EVAL_ROOT" && env -u CI INSTALL_ZONE_CACHE="$EVAL_TMP/cache" RENDER_DIR="$EVAL_TMP/render" \
    timeout 150 bash scripts/install-zone/install.sh render istiod >"$EVAL_TMP/out" 2>"$EVAL_TMP/err" )
rc=$?; cat "$EVAL_TMP/out" "$EVAL_TMP/err"
if [ $rc -ne 0 ]; then
  if [ -z "$(ls -A "$HOME/.cache/ztd-install-zone" 2>/dev/null)" ] && grep -qiE 'curl|download|resolve|fetch' "$EVAL_TMP/err"; then
    echo "UNVERIFIABLE: the pinned istiod chart could not be fetched (no cache, no network)"; exit 77; fi
  echo "FAIL: render istiod exited $rc"; exit 1
fi
f="$EVAL_TMP/render/istiod.yaml"
[ -s "$f" ] || { echo "FAIL: no rendered istiod manifest at RENDER_DIR/istiod.yaml"; ls "$EVAL_TMP/render"; exit 1; }
python3 - "$f" <<'PY'
import sys, yaml
docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if isinstance(d, dict)]
cms = [d for d in docs if d.get("kind") == "ConfigMap" and "mesh" in (d.get("data") or {})]
if not cms:
    sys.exit("FAIL: no ConfigMap with a mesh document in the istiod render")
for cm in cms:
    mesh = yaml.safe_load(cm["data"]["mesh"]) or {}
    got = ((mesh.get("meshMTLS") or {}).get("minProtocolVersion"))
    print(f"ConfigMap {cm['metadata'].get('name')}: meshMTLS.minProtocolVersion = {got!r}")
    if got != "TLSV1_3":
        sys.exit("FAIL: expected TLSV1_3")
print("PASS: rendered mesh configuration sets the mesh mTLS minimum to TLSV1_3")
PY
