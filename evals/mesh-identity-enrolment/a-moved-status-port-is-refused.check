#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A moved status port is refused
# level: L2
# requirement: The overrides that move or replace the capture or the proxy are refused in a plane namespace
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  dry_run eval-status-8080 --annotations=status.sidecar.istio.io/port=8080
  expect_refused
fi
static_mentions status.sidecar.istio.io/port annotations
