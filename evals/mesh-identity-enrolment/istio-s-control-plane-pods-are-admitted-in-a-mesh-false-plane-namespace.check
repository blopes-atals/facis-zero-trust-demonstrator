#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Istio's control-plane pods are admitted in a mesh: false plane namespace
# level: L2
# requirement: The injection opt-out is refused where the plane namespace is injected
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  labels=$(kubectl --context "$CTX" get ns istio-system -o jsonpath='{.metadata.labels}')
  echo "istio-system labels: $labels"
  python3 -c 'import json,sys; l=json.loads(sys.argv[1] or "{}"); sys.exit(0 if sys.argv[2] in l and "istio-injection" not in l and "istio.io/rev" not in l else 1)' "$labels" "$PLANE_LABEL" \
    || { echo "FAIL: istio-system must carry $PLANE_LABEL and no injection label (a mesh: false plane namespace)"; exit 1; }
  # Pods built from the istiod Deployment's and the istio-cni DaemonSet's pod templates.
  kubectl --context "$CTX" -n istio-system get deploy,ds -o json >"$EVAL_TMP/wl.json" || { echo "UNVERIFIABLE: cannot read istio-system workloads"; exit 77; }
  python3 - "$EVAL_TMP/wl.json" "$EVAL_TMP" <<'PY' || exit $?
import json, sys
items, tmp = json.load(open(sys.argv[1]))["items"], sys.argv[2]
want = {"istiod": lambda i: i["kind"] == "Deployment" and i["metadata"]["name"].startswith("istiod"),
        "istio-cni": lambda i: i["kind"] == "DaemonSet" and i["metadata"]["name"].startswith("istio-cni")}
for k, f in want.items():
    w = next((i for i in items if f(i)), None)
    if not w: print(f"UNVERIFIABLE: no {k} workload in istio-system"); sys.exit(77)
    t = w["spec"]["template"]; md = t.get("metadata") or {}
    inj = (md.get("labels") or {}).get("sidecar.istio.io/inject") or (md.get("annotations") or {}).get("sidecar.istio.io/inject")
    print(f"{k}: {w['kind']}/{w['metadata']['name']}, template sidecar.istio.io/inject={inj!r}")
    for ns, sa in (("cp", None), ("plane", "default")):
        spec = dict(t["spec"])
        if sa: spec["serviceAccountName"] = sa; spec.pop("serviceAccount", None)
        pod = {"apiVersion": "v1", "kind": "Pod", "spec": spec,
               "metadata": {"name": f"eval-{k}-template", "labels": md.get("labels") or {}, "annotations": md.get("annotations") or {}}}
        json.dump(pod, open(f"{tmp}/{k}-{ns}.json", "w"))
PY
  bad=0
  for k in istiod istio-cni; do
    dry_run_file istio-system "$EVAL_TMP/$k-cp.json"
    if [ "$rc" -eq 0 ]; then echo "PASS: $k pod admitted in istio-system"
    else echo "$out" | head -10; echo "FAIL: $k pod refused in istio-system"; bad=1; fi
    dry_run_file "$NS" "$EVAL_TMP/$k-plane.json"
    echo "--- $k pod in injected plane namespace $NS"
    ( expect_refused ); r=$?
    if [ $r -ne 0 ] && grep -q "PodSecurity\|violates PodSecurity" <<<"$out"; then
      echo "UNVERIFIABLE: Pod Security refused the $k pod in $NS before the policy was asked"; [ $bad -eq 0 ] && bad=77
    elif [ $r -ne 0 ]; then bad=1; fi
  done
  exit $bad
fi
# Without a cluster: the umbrella renders istio-system as a plane namespace without the injection
# label, and the rendered opt-out refusal depends on the namespace's injection label.
render_policy
helm template ztd "$EVAL_ROOT/deployment/helm/ztd" -f "$EVAL_ROOT/deployment/helm/ztd/ci/values.yaml" >"$EVAL_TMP/ztd.yaml" 2>"$EVAL_TMP/ztd.err" \
  || { cat "$EVAL_TMP/ztd.err"; echo "FAIL: helm template of the ztd umbrella failed"; exit 1; }
python3 - "$EVAL_TMP/zp.yaml" "$EVAL_TMP/ztd.yaml" "$PLANE_LABEL" <<'PY'
import sys, yaml
zp, ztd, plane = sys.argv[1:4]
ns = next((d for d in yaml.safe_load_all(open(ztd)) if isinstance(d, dict) and d.get("kind") == "Namespace" and d["metadata"]["name"] == "istio-system"), None)
if not ns: sys.exit("FAIL: the kind zone does not render the istio-system namespace")
l = ns["metadata"].get("labels") or {}
print(f"render: istio-system labels {l}")
if plane not in l or "istio-injection" in l or "istio.io/rev" in l:
    sys.exit("FAIL: istio-system is not a plane namespace without the injection label in the kind zone")
docs = [d for d in yaml.safe_load_all(open(zp)) if isinstance(d, dict)]
vaps = [d for d in docs if d.get("kind") == "ValidatingAdmissionPolicy"]
hit = False
for p in vaps:
    vars_ = {v["name"]: v["expression"] for v in p["spec"].get("variables") or []}
    for i, v in enumerate(p["spec"].get("validations") or []):
        e = v["expression"]
        text = e + " " + " ".join(x for n, x in vars_.items() if "variables." + n in e)
        if "sidecar.istio.io/inject" in text and "namespaceObject" in text and ("istio-injection" in text or "istio.io/rev" in text):
            print(f"render: policy {p['metadata']['name']!r}, validation {i} refuses sidecar.istio.io/inject only by the namespace's injection label"); hit = True
if not hit:
    sys.exit("FAIL: no rendered validation makes the injection opt-out refusal depend on the namespace's injection label")
print("UNVERIFIABLE: admission of the istiod and istio-cni pods in istio-system, and their refusal in an injected plane namespace, needs a kind cluster with the zone installed (Docker unreachable or EVAL_KIND not set)")
sys.exit(77)
PY
exit $?
