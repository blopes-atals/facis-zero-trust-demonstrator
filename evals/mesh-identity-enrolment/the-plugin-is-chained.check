#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The plugin is chained
# level: L2
# requirement: The default deny holds with the Istio CNI plugin chained behind Cilium and both control planes inside it
. "$(dirname "$0")/../lib.sh"
need_live
rc=0
ex=$(k -n kube-system get cm cilium-config -o jsonpath='{.data.cni-exclusive}')
echo "cilium-config cni-exclusive: $ex"; [ "$ex" = false ] || { echo "FAIL: cni-exclusive is not false"; rc=1; }
# The Istio CNI node agent mounts the node's CNI configuration directory; read it through each one.
for p in $(k -n "$ISTIO_NS" get pods -l k8s-app=istio-cni-node -o name); do
  node=$(k -n "$ISTIO_NS" get "$p" -o jsonpath='{.spec.nodeName}')
  dir=$(k -n "$ISTIO_NS" get "$p" -o json | jq -r '.spec.containers[0].volumeMounts[] | select(.name | test("cni-net-dir")) | .mountPath')
  conf=$(k -n "$ISTIO_NS" exec "$p" -- sh -c "ls $dir/*.conflist | head -1 | xargs cat" 2>/dev/null)
  types=$(jq -r '[.plugins[].type] | join(" ")' <<<"$conf" 2>/dev/null)
  echo "node $node ($dir): plugins: $types"
  ci=$(tr ' ' '\n' <<<"$types" | grep -n '^cilium-cni$' | cut -d: -f1); ii=$(tr ' ' '\n' <<<"$types" | grep -n '^istio-cni$' | cut -d: -f1)
  [ -n "$ci" ] && [ -n "$ii" ] && [ "$ii" -gt "$ci" ] && echo "  PASS: istio-cni after cilium-cni" || { echo "  FAIL"; rc=1; }
done
[ -n "${node:-}" ] || { echo "FAIL: no istio-cni-node pod"; rc=1; }
evidence_section_passed default-deny-with-chained-cni || { echo "FAIL: the proof's evidence does not show it"; rc=1; }
exit $rc
