#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A pod-supplied istio-proxy container is refused
# level: L2
# requirement: The overrides that move or replace the capture or the proxy are refused in a plane namespace
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  cat >"$EVAL_TMP/pod.yaml" <<YAML
apiVersion: v1
kind: Pod
metadata: { name: eval-own-istio-proxy }
spec:
  restartPolicy: Never
  containers:
    - { name: app, image: $IMG, args: ["pause"] }
    - { name: istio-proxy, image: docker.io/library/busybox:1.36, command: ["sleep", "3600"] }
YAML
  dry_run_file "$NS" "$EVAL_TMP/pod.yaml"
  expect_refused
fi
# The requirement names the annotation the injector writes when the pod brings its own istio-proxy.
static_mentions proxy.istio.io/overrides annotations
