#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Empty cluster to all Ready
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
rc=$(cat "$(setup_file install1.rc)"); echo "first install exit code: $rc"
tail -4 "$SETUP_DIR/install1.log"
[ "$rc" = 0 ] || { echo "expected exit 0, got $rc"; exit 1; }
nss="spire-system istio-system $MGMT ztd-data"
bad=$(pods_not_ready $nss); [ -z "$bad" ] || { echo "pods not Ready: $bad"; exit 1; }
k -n "$MGMT" get pod ztd-openbao-0 -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' | grep -q True || { echo "OpenBao server not Ready"; exit 1; }
echo "all pods in $nss Ready, OpenBao server among them"
