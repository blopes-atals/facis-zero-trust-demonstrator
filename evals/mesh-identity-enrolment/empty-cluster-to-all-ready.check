#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Empty cluster to all Ready
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
need_kind
[ -z "$(releases_installed)" ] || { echo "UNVERIFIABLE: the cluster is not empty: $(releases_installed | tr '\n' ' ')"; exit 77; }
install_zone install; cat "$EVAL_TMP/inst.out" "$EVAL_TMP/inst.err" | tail -40
[ $rc -eq 0 ] || { echo "FAIL: install exited $rc"; exit 1; }
bad=$(not_ready_pods); [ -z "$bad" ] || { echo "FAIL: pods not Ready: $bad"; exit 1; }
echo "PASS: install exited 0, every pod Ready"
