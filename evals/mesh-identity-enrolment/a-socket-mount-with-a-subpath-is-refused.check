#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A socket mount with a subPath is refused
# level: L2
# requirement: The SPIRE socket is mounted whole
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || { echo "UNVERIFIABLE: the API server's answer needs a kind cluster with the zone installed (EVAL_KIND=1, EVAL_KIND_CONTEXT)"; exit 77; }
cluster_setup
injected_reference "$EVAL_TMP/ref.json"
SOCK='m = next((x for x in proxy.get("volumeMounts") or [] if x["name"] == "workload-socket" and x["mountPath"] == "/var/run/secrets/workload-spiffe-uds"), None)
assert m, "the injected istio-proxy does not mount workload-socket at /var/run/secrets/workload-spiffe-uds"
'
bad=0
echo "--- subPath: socket"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/sp.json" eval-socket-subpath "$SOCK"'m["subPath"] = "socket"' \
  || { echo "UNVERIFIABLE: no workload-socket mount on the injected proxy"; exit 77; }
dry_run_file "$NS" "$EVAL_TMP/sp.json"; refused_naming "socket rule" || { echo "FAIL: subPath case"; bad=1; }
echo "--- subPathExpr"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/spe.json" eval-socket-subpathexpr "$SOCK"'m["subPathExpr"] = "$(POD_NAME)"' || exit 77
dry_run_file "$NS" "$EVAL_TMP/spe.json"; refused_naming "socket rule" || { echo "FAIL: subPathExpr case"; bad=1; }
[ $bad -eq 0 ] && echo "PASS: subPath and subPathExpr on the socket mount refused naming the socket rule"
exit $bad
