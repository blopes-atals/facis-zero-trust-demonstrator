#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A second proxy under another name is refused
# level: L2
# requirement: Every mesh proxy in a plane namespace is the injector's
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || { echo "UNVERIFIABLE: the API server's refusal needs a kind cluster with the zone installed (EVAL_KIND=1, EVAL_KIND_CONTEXT)"; exit 77; }
cluster_setup
# The injector's own proxy: image and arguments, read from a server dry-run of an ordinary pod.
dry_run eval-injected-reference
[ "$rc" -eq 0 ] || { echo "$out" | head; echo "UNVERIFIABLE: could not obtain an injected reference pod in $NS"; exit 77; }
printf '%s' "$out" >"$EVAL_TMP/ref.json"
python3 - "$EVAL_TMP/ref.json" "$EVAL_TMP/pod.json" "$IMG" <<'PY' || exit 77
import json, sys
ref, out, img = sys.argv[1:4]
p = json.load(open(ref))
proxy = next((c for c in (p["spec"].get("initContainers") or []) + p["spec"]["containers"] if c["name"] == "istio-proxy"), None)
if not proxy: print("UNVERIFIABLE: the reference pod was not injected"); sys.exit(77)
sock = next((m for m in proxy.get("volumeMounts") or [] if m["mountPath"] == "/var/run/secrets/workload-spiffe-uds"), None)
if not sock: print("UNVERIFIABLE: the injected proxy does not mount the SPIRE socket path"); sys.exit(77)
print(f"injector's proxy: image {proxy['image']}, args {proxy.get('args')}, socket volume {sock['name']}")
second = {"name": "mesh", "image": proxy["image"], "args": proxy.get("args") or [],
          "env": [{"name": "PROXY_CONFIG", "value": '{"discoveryAddress":"eval-elsewhere.ztd-data.svc:15012"}'}],
          "volumeMounts": [{"name": sock["name"], "mountPath": sock["mountPath"], "readOnly": True}]}
pod = {"apiVersion": "v1", "kind": "Pod", "metadata": {"name": "eval-second-proxy"},
       "spec": {"restartPolicy": "Never", "containers": [{"name": "app", "image": img, "args": ["pause"]}, second]}}
json.dump(pod, open(out, "w"))
PY
ns_labels=$(kubectl --context "$CTX" get ns "$NS" -o jsonpath='{.metadata.labels}'); echo "namespace $NS labels: $ns_labels"
dry_run_file "$NS" "$EVAL_TMP/pod.json"
expect_refused "proxy rule"
