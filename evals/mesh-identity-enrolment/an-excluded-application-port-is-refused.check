#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / An excluded application port is refused
# level: L2
# requirement: A pod in a plane namespace keeps the proxy's traffic capture at the injector's defaults
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  dry_run eval-exclude-8080 --annotations=traffic.sidecar.istio.io/excludeInboundPorts=8080
  expect_refused "capture"
fi
static_mentions traffic.sidecar.istio.io/excludeInboundPorts annotations
