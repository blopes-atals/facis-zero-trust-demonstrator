#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / An unknown release is named to render
# level: L1
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
make_shims
fail=0
for args in "no-such-release" "spire no-such-release"; do
  # shellcheck disable=SC2086
  run_shimmed "$KIND_ZONE" render $args
  echo "== render $args: exit $rc"; echo "stderr: $err"; [ -n "$out" ] && echo "stdout: $out"
  [ "$rc" -ne 0 ] || { echo "FAIL: expected non-zero exit, got 0"; fail=1; }
  for r in $SEVEN; do grep -qw -- "$r" <<<"$out $err" || { echo "FAIL: message does not list release $r"; fail=1; }; done
  [ -z "$(ls -A "$EVAL_TMP/render")" ] || { echo "FAIL: something was rendered: $(ls "$EVAL_TMP/render")"; fail=1; }
  grep -qE '^helm template' "$EVAL_TMP/calls.log" && { echo "FAIL: helm template was called"; fail=1; }
done
exit $fail
