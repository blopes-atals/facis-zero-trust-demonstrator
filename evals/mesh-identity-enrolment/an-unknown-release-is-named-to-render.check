#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / An unknown release is named to render
# level: L1
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/lib.sh"
cache
rm -rf "$EVAL_TMP/out"; mkdir -p "$EVAL_TMP/out"
out=$(RENDER_DIR=$EVAL_TMP/out "$INSTALL" render nonesuch 2>&1); rc=$?
echo "$out"
[ $rc -ne 0 ] || { echo "expected non-zero exit, got 0"; exit 1; }
for r in ztd spire-crds spire istio-base istiod istio-cni zone-policy ztd-openbao; do
  grep -q "$r" <<<"$out" || { echo "release name $r not listed"; exit 1; }
done
[ -z "$(ls -A "$EVAL_TMP/out")" ] || { echo "something was rendered: $(ls "$EVAL_TMP/out")"; exit 1; }
