#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / An unknown release is named to render
# level: L1
# requirement: A zone installs from an empty cluster in one order, idempotently
# Literal reading: "renders nothing" also when the unknown name comes after a valid one.
. "$(dirname "$0")/../lib.sh"
rc=0
for args in "no-such-release" "spire no-such-release"; do
  d=$EVAL_TMP/r-${args// /_}; mkdir -p "$d"
  out=$(RENDER_DIR=$d KUBE_CONTEXT=ztd-eval-no-such-context timeout 120 "$INSTALL" render $args 2>&1); r=$?
  echo "install.sh render $args: exit $r"; tail -4 <<<"$out" | sed 's/^/  /'
  [ $r -ne 0 ] || { echo "  FAIL: exited 0"; rc=1; }
  miss=""; for n in ztd spire-crds spire istio-base istiod istio-cni zone-policy; do grep -qw -- "$n" <<<"$out" || miss="$miss $n"; done
  [ -z "$miss" ] && echo "  PASS: the message lists the seven release names" || { echo "  FAIL: release names not listed:$miss"; rc=1; }
  files=$(find "$d" -type f | wc -l); docs=$(grep -c '^kind:' <<<"$out")
  [ "$files" -eq 0 ] && [ "$docs" -eq 0 ] && echo "  PASS: nothing rendered" || { echo "  FAIL: rendered $files files, $docs manifests on the output"; rc=1; }
done
exit $rc
