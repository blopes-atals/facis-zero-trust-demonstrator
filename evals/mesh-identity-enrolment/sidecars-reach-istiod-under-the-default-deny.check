#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Sidecars reach istiod under the default deny
# level: L2
# requirement: The mesh control-plane openings are rendered only when the zone enables them
. "$(dirname "$0")/../lib.sh"
need_live
rc=0
istioctl --context "$CTX" proxy-status -o json > "$EVAL_TMP/ps.json" 2>"$EVAL_TMP/ps.err" || { echo "FAIL: istioctl proxy-status"; cat "$EVAL_TMP/ps.err"; exit 1; }
st=$(jq -r '.resources[] | select(.node.id == "ev-client.ztd-data") | .genericXdsConfigs[] | "\(.typeUrl | split(".") | last) \(.configStatus)"' "$EVAL_TMP/ps.json")
echo "ev-client.$DATA xDS status:"; sed 's/^/  /' <<<"$st"
[ -n "$st" ] && ! grep -qv ' SYNCED$' <<<"$st" && echo "PASS: SYNCED" || { echo "FAIL: not SYNCED for every type"; rc=1; }
cls=$(classify_policies "$DATA" | sort)
echo "network policies of $DATA by class:"; sed 's/^/  /' <<<"$cls"
other=$(grep -v -E '^(default-deny|dns-bypass|intra-plane|matrix:.*|mesh-control-plane:egress:15012)$' <<<"$cls")
for want in default-deny dns-bypass intra-plane 'mesh-control-plane:egress:15012'; do grep -qx "$want" <<<"$cls" || { echo "FAIL: missing $want"; rc=1; }; done
grep -q '^matrix:' <<<"$cls" || { echo "FAIL: no matrix lane"; rc=1; }
[ -z "$other" ] || { echo "FAIL: other policies: $other"; rc=1; }
exit $rc
