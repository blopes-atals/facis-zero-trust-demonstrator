#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / TLS 1.3 is accepted and TLS 1.2 is refused
# level: L1
# requirement: The mesh enforces TLS 1.3 as the minimum for mesh mTLS
# Reads the committed proof output. The proof itself needs a kind cluster; when the committed
# evidence predates the TLS 1.3 values change it has not been regenerated yet -> UNVERIFIABLE.
cd "$EVAL_ROOT" || exit 1
ev=docs/evidences/mesh-identity/evidence.md; envj=docs/evidences/mesh-identity/environment.json
[ -f "$ev" ] || { echo "FAIL: $ev missing"; exit 1; }
sec=$(awk '/^## /{p = ($0 ~ /^## 8\./)} p' "$ev")
[ -n "$sec" ] || sec=$(cat "$ev")
l13=$(grep -inE 'tls ?(v)?1\.3|tlsv1\.3' <<<"$sec")
l12=$(grep -inE 'tls ?(v)?1\.2|tls-max 1\.2' <<<"$sec")
echo "TLS 1.3 lines:"; echo "${l13:-<none>}"; echo "TLS 1.2 lines:"; echo "${l12:-<none>}"
ok13=; ok12=
python3 - "$ev" <<'PY' && ok=1
import re, sys
text = open(sys.argv[1]).read()
m = re.search(r"^## 8\..*?(?=^## )", text, re.S | re.M)
sec = m.group(0) if m else text
# a block (bullet with its continuation lines) that mentions TLS 1.3 and an HTTP 200
blocks = re.split(r"\n(?=[-*] |\S)", sec)
b13 = [b for b in blocks if re.search(r"tls ?v?1\.3|tlsv1\.3", b, re.I) and re.search(r"\b200\b", b)]
b12 = [b for b in blocks if re.search(r"tls ?v?1\.2|tls-max 1\.2", b, re.I) and re.search(r"alert", b, re.I) and re.search(r"protocol|version", b, re.I)]
print("TLS 1.3 answered 200:", bool(b13)); print("TLS 1.2 refused with a protocol alert:", bool(b12))
sys.exit(0 if b13 and b12 else 1)
PY
[ -n "${ok:-}" ] && { echo "PASS: the evidence shows TLS 1.3 answered 200 and TLS 1.2 refused with a protocol alert"; exit 0; }
evc=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("commit",""))' "$envj" 2>/dev/null)
tlsc=$(git log --format=%H -S TLSV1_3 -- deployment/helm/values/istiod.yaml | tail -1)
echo "evidence commit: ${evc:-?}; commit introducing TLSV1_3: ${tlsc:-?}"
if [ -n "$tlsc" ] && { [ -z "$evc" ] || ! git merge-base --is-ancestor "$tlsc" "$evc" 2>/dev/null; }; then
  echo "UNVERIFIABLE: the mesh-identity evidence predates the TLS 1.3 change and has not been regenerated (needs scripts/verify-mesh-identity/verify.sh on a kind cluster)"
  exit 77
fi
echo "FAIL: the evidence (generated after the change) does not show both outcomes"; exit 1
