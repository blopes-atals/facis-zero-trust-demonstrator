#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A pod-supplied hook or capability on the proxy is refused
# level: L2
# requirement: Every mesh proxy in a plane namespace is the injector's
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || { echo "UNVERIFIABLE: the API server's answer needs a kind cluster with the zone installed (EVAL_KIND=1, EVAL_KIND_CONTEXT)"; exit 77; }
cluster_setup
injected_reference "$EVAL_TMP/ref.json"
bad=0
echo "--- postStart exec hook of its own"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/hook.json" eval-proxy-hook \
  'proxy.setdefault("lifecycle", {})["postStart"] = {"exec": {"command": ["/bin/sh", "-c", "echo eval-own-hook"]}}'
dry_run_file "$NS" "$EVAL_TMP/hook.json"; refused_naming "proxy rule" || { echo "FAIL: postStart hook case"; bad=1; }
echo "--- NET_ADMIN capability"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/cap.json" eval-proxy-netadmin \
  'sc = proxy.setdefault("securityContext", {}); caps = sc.setdefault("capabilities", {}); caps["add"] = (caps.get("add") or []) + ["NET_ADMIN"]'
dry_run_file "$NS" "$EVAL_TMP/cap.json"; refused_naming "proxy rule" || { echo "FAIL: NET_ADMIN case"; bad=1; }
echo "--- AND: the same pod whose istio-proxy adds nothing"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/same.json" eval-proxy-as-injected 'pass'
dry_run_file "$NS" "$EVAL_TMP/same.json"
echo "exit $rc"; echo "$out" | head -n 6 | cut -c1-400
[ "$rc" -eq 0 ] || { echo "FAIL: the pod whose istio-proxy is exactly the injector's was refused"; bad=1; }
[ $bad -eq 0 ] && echo "PASS: hook and NET_ADMIN refused naming the proxy rule; the unchanged injected pod admitted"
exit $bad
