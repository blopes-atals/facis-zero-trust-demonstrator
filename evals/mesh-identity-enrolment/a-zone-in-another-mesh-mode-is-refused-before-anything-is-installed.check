#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A zone in another mesh mode is refused before anything is installed
# level: L1
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
make_shims
fail=0
for mode in ambient none; do
  zone="$EVAL_TMP/zone-$mode.yaml"
  derive_zone "$zone" "z['mesh']['mode'] = '$mode'" || { echo "could not derive the zone file"; exit 1; }
  for cmd in render install; do
    run_shimmed "$zone" "$cmd"
    echo "== mode=$mode $cmd: exit $rc"; echo "stderr: $err"; [ -n "$out" ] && echo "stdout: $out"
    echo "helm/kubectl calls: $(tr '\n' ';' <"$EVAL_TMP/calls.log")"
    [ "$rc" -ne 0 ] || { echo "FAIL($mode/$cmd): expected non-zero exit, got 0"; fail=1; }
    msg="$out $err"
    grep -qF 'mesh.mode' <<<"$msg" || { echo "FAIL($mode/$cmd): message does not name mesh.mode"; fail=1; }
    grep -qF "$mode" <<<"$msg" || { echo "FAIL($mode/$cmd): message does not name the value $mode"; fail=1; }
    grep -qi 'sidecar' <<<"$msg" || { echo "FAIL($mode/$cmd): message does not state the reason (sidecar mode only)"; fail=1; }
    [ -z "$(ls -A "$EVAL_TMP/render")" ] || { echo "FAIL($mode/$cmd): something was rendered: $(ls "$EVAL_TMP/render")"; fail=1; }
    if grep -qE '^helm (template|upgrade|install)|^kubectl ' "$EVAL_TMP/calls.log"; then
      echo "FAIL($mode/$cmd): a release was rendered/installed or the cluster contacted before the refusal"; fail=1; fi
  done
done
exit $fail
