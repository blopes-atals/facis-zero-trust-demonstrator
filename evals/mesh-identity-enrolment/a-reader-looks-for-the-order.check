#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A reader looks for the order
# level: L1
# requirement: The documentation presents the install order of the seven releases
. "$EVAL_ROOT/evals/lib.sh"
d=$EVAL_ROOT/docs/environments/osc.md
[ -f "$d" ] || { echo "missing $d"; exit 1; }
python3 - "$d" <<'PY'
import sys, re
t = open(sys.argv[1]).read()
order = ["ztd", "spire-crds", "spire", "istio-base", "istiod", "istio-cni", "zone-policy", "ztd-openbao"]
assert "scripts/install-zone/install.sh" in t, "installer script not named"
# find the first position at which all eight names appear in order, as code spans
pos = -1
for r in order:
    m = re.search(r"`%s`" % re.escape(r), t[pos+1:])
    assert m, "release %s not found in order after position %d" % (r, pos)
    pos = pos + 1 + m.end()
    print("found", r)
assert re.search(r"eight", t, re.I), "document does not say eight releases"
print("ok")
PY
