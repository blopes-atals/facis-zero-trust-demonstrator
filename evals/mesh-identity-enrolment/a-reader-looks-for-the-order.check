#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A reader looks for the order
# level: L1
# requirement: The documentation presents the install order of the seven releases
. "$(dirname "$0")/../lib.sh"
python3 - "$REPO/docs/environments/osc.md" <<'PY'
import re, sys
t = open(sys.argv[1]).read()
want = ["ztd", "spire-crds", "spire", "istio-base", "istiod", "istio-cni", "zone-policy"]
fails = []
def ok(c, m):
    print(("PASS: " if c else "FAIL: ") + m)
    if not c: fails.append(m)
rows = re.findall(r"^\|\s*(\d+)\s*\|\s*`([a-z-]+)`\s*\|.*?\|\s*([^|]*)\|\s*$", t, re.M)
order = [r[1] for r in sorted(rows, key=lambda r: int(r[0]))]
ok(order == want, f"release order in the guide: {order}")
ok("scripts/install-zone/install.sh" in t, "names the installer script")
secs = re.split(r"^## ", t, flags=re.M)
steps = {r[1]: r[2] for r in rows}
nums = set(re.findall(r"\d", " ".join(steps.values())))
print("steps that carry the releases:", sorted(nums))
for n in sorted(nums):
    s = next((x for x in secs if x.startswith(f"{n}. ")), "")
    ok("**Verify:**" in s, f"step {n} ({s.splitlines()[0] if s else '?'}) has a verification")
ok(bool(nums), "each release is assigned to a step")
sys.exit(1 if fails else 0)
PY
