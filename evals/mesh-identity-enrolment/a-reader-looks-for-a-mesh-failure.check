#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A reader looks for a mesh failure
# level: L1
# requirement: The documentation lists the control-plane openings and the mesh failure modes
. "$(dirname "$0")/../lib.sh"
f=$REPO/docs/troubleshooting.md
rows=$(grep '^|' "$f" | grep -v '^|---')
rc=0
row() { # row <label> <filter1> <filter2>
  local r; r=$(grep -i "$2" <<<"$rows" | grep -i "$3" | head -1)
  if [ -n "$r" ]; then echo "PASS: row for $1: ${r:0:160}"; else echo "FAIL: no row for $1"; rc=1; fi
}
row "a proxy without a certificate" 'proxy' 'no workload certificate\|without a certificate\|no certificate\|holds no'
row "a proxy without a root bundle" 'ROOTCA\|root bundle' 'no `ROOTCA`\|no ROOTCA\|without a root\|no root'
row "a pod stuck before its socket is mounted" 'socket\|csi.spiffe.io' 'stuck\|ContainerCreating'
exit $rc
