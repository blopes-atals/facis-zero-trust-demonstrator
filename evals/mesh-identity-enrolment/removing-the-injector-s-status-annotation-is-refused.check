#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / Removing the injector's status annotation is refused
# level: L2
# requirement: Status updates and removals are checked
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || { echo "UNVERIFIABLE: the API server's answer needs a kind cluster with the zone installed (EVAL_KIND=1, EVAL_KIND_CONTEXT)"; exit 77; }
cluster_setup
running_pod eval-status-removal
out=$(kubectl --context "$CTX" -n "$NS" annotate pod "$RP" sidecar.istio.io/status- --dry-run=server -o name 2>&1); rc=$?
expect_refused "capture rule"
