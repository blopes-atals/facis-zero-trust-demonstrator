#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A proxy volume of another kind is refused
# level: L2
# requirement: The proxy's mounts and volumes are the injector's
# The pod is the injector's own output resubmitted host-networked (the scenario's example of a pod the
# injector does not rewrite); only the named volume's kind is changed. The same host-networked pod with
# the injector's volumes is shown as the control.
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || { echo "UNVERIFIABLE: the API server's answer needs a kind cluster with the zone installed (EVAL_KIND=1, EVAL_KIND_CONTEXT)"; exit 77; }
cluster_setup
injected_reference "$EVAL_TMP/ref.json"
python3 -c 'import json,sys; print("reference volumes:", {v["name"]: [k for k in v if k != "name"] for v in json.load(open(sys.argv[1]))["spec"]["volumes"]})' "$EVAL_TMP/ref.json"
HN='p["spec"]["hostNetwork"] = True; '
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/ctl.json" eval-volumes-as-injected "$HN"
dry_run_file "$NS" "$EVAL_TMP/ctl.json"; echo "control (host-networked, the injector's volumes): exit $rc"
bad=0
echo "--- istio-podinfo as a configMap"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/cm.json" eval-podinfo-configmap \
  "$HN"'assert "istio-podinfo" in vols, "no istio-podinfo volume"; v = vols["istio-podinfo"]; [v.pop(k) for k in list(v) if k != "name"]; v["configMap"] = {"name": "kube-root-ca.crt"}' \
  || { echo "UNVERIFIABLE: the injected reference has no istio-podinfo volume"; exit 77; }
dry_run_file "$NS" "$EVAL_TMP/cm.json"; refused_naming "proxy rule" || { echo "FAIL: istio-podinfo configMap case"; bad=1; }
echo "--- istio-envoy as a hostPath"
mutate "$EVAL_TMP/ref.json" "$EVAL_TMP/hp.json" eval-envoy-hostpath \
  "$HN"'assert "istio-envoy" in vols, "no istio-envoy volume"; v = vols["istio-envoy"]; [v.pop(k) for k in list(v) if k != "name"]; v["hostPath"] = {"path": "/tmp/eval-istio-envoy", "type": "DirectoryOrCreate"}' \
  || { echo "UNVERIFIABLE: the injected reference has no istio-envoy volume"; exit 77; }
dry_run_file "$NS" "$EVAL_TMP/hp.json"; refused_naming "proxy rule" || { echo "FAIL: istio-envoy hostPath case"; bad=1; }
[ $bad -eq 0 ] && echo "PASS: both volume kinds refused naming the proxy rule"
exit $bad
