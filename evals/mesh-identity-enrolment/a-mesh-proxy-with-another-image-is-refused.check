#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A mesh proxy with another image is refused
# level: L2
# requirement: Every mesh proxy in a plane namespace is the injector's
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  cat >"$EVAL_TMP/pod.yaml" <<YAML
apiVersion: v1
kind: Pod
metadata: { name: eval-proxy-other-image }
spec:
  restartPolicy: Never
  volumes:
    - name: workload-socket
      csi: { driver: csi.spiffe.io, readOnly: true }
  containers:
    - { name: app, image: $IMG, args: ["pause"] }
    - name: istio-proxy
      image: docker.io/library/busybox:1.36
      args: ["proxy", "sidecar"]
      volumeMounts:
        - { name: workload-socket, mountPath: /var/run/secrets/workload-spiffe-uds, readOnly: true }
YAML
  dry_run_file "$NS" "$EVAL_TMP/pod.yaml"
  expect_refused "proxy rule"
fi
# Without a cluster: the rendered, Deny-bound, plane-scoped policy compares every mesh proxy's image
# with the chart's proxyImage value, and its refusal names the proxy rule.
render_policy
python3 - "$EVAL_TMP/zp.yaml" "$(proxy_image)" "$PLANE_LABEL" <<'PY'
import sys, yaml
f, img, plane = sys.argv[1:4]
if not img: sys.exit("FAIL: zone-policy values.yaml has no proxySocketPolicy.proxyImage")
docs = [d for d in yaml.safe_load_all(open(f)) if isinstance(d, dict)]
vaps = {d["metadata"]["name"]: d for d in docs if d.get("kind") == "ValidatingAdmissionPolicy"}
hit = []
for b in (d for d in docs if d.get("kind") == "ValidatingAdmissionPolicyBinding"):
    s = b["spec"]; p = vaps.get(s.get("policyName"))
    sel = (s.get("matchResources") or {}).get("namespaceSelector") or {}
    if not p or "Deny" not in s.get("validationActions", []): continue
    if not any(e.get("key") == plane for e in sel.get("matchExpressions") or []) and plane not in (sel.get("matchLabels") or {}): continue
    for i, v in enumerate(p["spec"].get("validations") or []):
        if img in v["expression"] and ".image" in v["expression"] and "proxy rule" in v.get("message", "").lower():
                hit.append((p["metadata"]["name"], i, v["message"].strip()[:160]))
if not hit:
    sys.exit(f"FAIL: no Deny-bound plane-scoped validation compares the proxy image with {img!r} and names the proxy rule")
for n, i, m in hit: print(f"render: policy {n!r}, validation {i} compares the proxy image with {img}; message: {m}...")
print("UNVERIFIABLE: the rendered policy carries the proxy rule, but the API server's refusal needs a kind cluster with the zone installed (Docker unreachable or EVAL_KIND not set)")
sys.exit(77)
PY
exit $?
