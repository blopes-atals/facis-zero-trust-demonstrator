#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The control planes answer only through their openings
# level: L2
# requirement: The default deny holds with the Istio CNI plugin chained behind Cilium and both control planes inside it
. "$(dirname "$0")/../lib.sh"
need_live
probe_control
rc=0
s=$(classify_policies "$SPIRE_NS" | sort | xargs); i=$(classify_policies "$ISTIO_NS" | sort | xargs)
echo "$SPIRE_NS: $s"; echo "$ISTIO_NS: $i"
[ "$s" = "api-lane default-deny dns-bypass entity-ingress:8081 entity-ingress:9443 intra-plane" ] && echo "PASS: $SPIRE_NS holds only the declared openings" || { echo "FAIL: $SPIRE_NS"; rc=1; }
[ "$i" = "api-lane default-deny dns-bypass entity-ingress:15017 intra-plane mesh-control-plane:ingress:15012" ] && echo "PASS: $ISTIO_NS holds only the declared openings" || { echo "FAIL: $ISTIO_NS"; rc=1; }
want=$(k -n "$SPIRE_NS" get ds spire-agent -o jsonpath='{.status.desiredNumberScheduled}'); ready=$(k -n "$SPIRE_NS" get ds spire-agent -o jsonpath='{.status.numberReady}')
att=$(spire_server agent list -output json | jq '.agents | length')
echo "agents: desired $want, Ready $ready, attested $att"
[ "$want" -gt 0 ] && [ "$ready" = "$want" ] && [ "$att" = "$want" ] && echo "PASS: the agents are served" || { echo "FAIL: agents"; rc=1; }
istioctl --context "$CTX" proxy-status -o json > "$EVAL_TMP/ps.json" 2>/dev/null
bad=$(jq -r '.resources[] | select(.node.id | test("^ev-(client|peer|crossplane|verif)\\.")) | .node.id as $n | .genericXdsConfigs[] | select(.configStatus != "SYNCED") | "\($n) \(.typeUrl)"' "$EVAL_TMP/ps.json")
n=$(jq '[.resources[] | select(.node.id | test("^ev-(client|peer|crossplane|verif)\\."))] | length' "$EVAL_TMP/ps.json")
echo "registered proxies: $n, not SYNCED: ${bad:-none}"
[ "$n" = 4 ] && [ -z "$bad" ] && echo "PASS: the proxies are served" || { echo "FAIL: proxies"; rc=1; }
sip=$(k -n "$SPIRE_NS" get pod spire-server-0 -o jsonpath='{.status.podIP}')
ipod=$(k -n "$ISTIO_NS" get pod -l app=istiod -o jsonpath='{.items[0].metadata.name}'); iip=$(k -n "$ISTIO_NS" get pod "$ipod" -o jsonpath='{.status.podIP}')
std="80 443 8080 8081 8082 8083 8443 9443 9988 15010 15012 15014 15017"
for p in $( { pod_ports "$SPIRE_NS" spire-server-0; tr ' ' '\n' <<<"$std"; } | sort -un); do
  r=$(tcp_probe "$DATA" ev-probe app "$sip" "$p"); echo "  ev-probe -> SPIRE server $sip:$p $r"; [ "$r" = dropped ] || rc=1
done
for p in $( { pod_ports "$ISTIO_NS" "$ipod"; tr ' ' '\n' <<<"$std"; } | sort -un | grep -vx 15012); do
  r=$(tcp_probe "$DATA" ev-probe app "$iip" "$p"); echo "  ev-probe -> istiod $iip:$p $r"; [ "$r" = dropped ] || rc=1
done
evidence_section_passed control-planes-under-default-deny || { echo "FAIL: the proof's evidence does not show it"; rc=1; }
exit $rc
