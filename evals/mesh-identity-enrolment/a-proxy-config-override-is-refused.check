#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A proxy-config override is refused
# level: L2
# requirement: The overrides that move or replace the capture or the proxy are refused in a plane namespace
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
if kind_available; then
  cluster_setup
  # "with any value": an empty mesh config document is the least a pod could set
  dry_run eval-proxy-config "--annotations=proxy.istio.io/config={}"
  expect_refused
fi
static_mentions proxy.istio.io/config annotations
