#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A label on a running pod is admitted, an added exclusion refused
# level: L2
# requirement: A pod update is checked for what it changes
# A pod that carries an annotation the capture rule refuses on creation (proxy.istio.io/config) can
# only be running in a plane namespace if it predates the rule there: the check runs it in a scratch
# namespace, waits until it is Running, then gives the namespace the plane label (no injection label)
# and updates the pod. The scratch namespace is deleted at the end.
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_capture.sh"
kind_available || static_mentions traffic.sidecar.istio.io/excludeInboundPorts annotations
cluster_setup
S=eval-upd-$(date +%s)-$$
trap 'kubectl --context "$CTX" delete ns "$S" --wait=false >/dev/null 2>&1' EXIT
kubectl --context "$CTX" create ns "$S" >/dev/null || { echo "UNVERIFIABLE: cannot create scratch namespace"; exit 77; }
kubectl --context "$CTX" -n "$S" run probe --image="$IMG" --restart=Never "--annotations=proxy.istio.io/config={}" -- pause >/dev/null \
  || { echo "UNVERIFIABLE: cannot create the pod in the scratch namespace"; exit 77; }
for _ in $(seq 120); do
  ph=$(kubectl --context "$CTX" -n "$S" get pod probe -o jsonpath='{.status.phase}'); [ "$ph" = Running ] && break; sleep 1
done
[ "$ph" = Running ] || { echo "UNVERIFIABLE: the pod did not reach Running (phase $ph)"; exit 77; }
kubectl --context "$CTX" label ns "$S" "$PLANE_LABEL=data" >/dev/null || { echo "UNVERIFIABLE: cannot label the scratch namespace"; exit 77; }
echo "running pod $S/probe with proxy.istio.io/config, namespace now labelled $PLANE_LABEL=data"
# precondition: that pod would be refused on creation here
pre=$(kubectl --context "$CTX" -n "$S" run probe2 --image="$IMG" --restart=Never "--annotations=proxy.istio.io/config={}" --dry-run=server -o name 2>&1); prc=$?
echo "precondition (same annotation on creation): exit $prc ${pre:0:200}"
[ $prc -ne 0 ] || { echo "UNVERIFIABLE: the plane label did not bring the policy into force in $S (creation was admitted)"; exit 77; }
# Admission policy bindings select namespaces through an informer; wait briefly for the label to be seen
out=$(kubectl --context "$CTX" -n "$S" label pod probe eval.facis.io/touched=yes 2>&1); rc=$?
echo "label update: exit $rc $out"
[ $rc -eq 0 ] || { echo "FAIL: the label update on the running pod was refused"; exit 1; }
out=$(kubectl --context "$CTX" -n "$S" annotate pod probe traffic.sidecar.istio.io/excludeInboundPorts=8080 2>&1); rc=$?
echo "--- exclusion update"
expect_refused "capture"
