#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The issuer and the bundle are SPIRE
# level: L2
# requirement: The mesh identity and its trust bundle are proven to be SPIRE-issued
. "$(dirname "$0")/../lib.sh"
need_live
T=$EVAL_TMP; rc=0
istioctl --context "$CTX" proxy-config secret ev-client."$DATA" -o json > "$T/sec.json" || { echo "FAIL: istioctl proxy-config secret"; exit 1; }
jq -r '.dynamicActiveSecrets[] | select(.name == "default") | .secret.tlsCertificate.certificateChain.inlineBytes' "$T/sec.json" | base64 -d > "$T/chain.pem"
# ROOTCA: a plain trusted CA, or (Istio's SPIFFE validator) one trust bundle per trust domain
jq -r '.dynamicActiveSecrets[] | select(.name == "ROOTCA") | .secret.validationContext | (.trustedCa.inlineBytes // empty), (.customValidatorConfig.typedConfig.trustDomains[]?.trustBundle.inlineBytes)' "$T/sec.json" | while read -r b; do base64 -d <<<"$b"; echo; done > "$T/root.pem"
echo "ROOTCA trust domains: $(jq -r '[.dynamicActiveSecrets[] | select(.name == "ROOTCA") | .secret.validationContext.customValidatorConfig.typedConfig.trustDomains[]?.name] | join(",")' "$T/sec.json")"
spire_bundle_pem > "$T/bundle.pem"
openssl x509 -in "$T/chain.pem" -noout -subject -issuer -ext subjectAltName 2>&1 | sed 's/^/  leaf: /'
subj=$(openssl x509 -in "$T/chain.pem" -noout -subject -nameopt RFC2253)
iss=$(openssl x509 -in "$T/chain.pem" -noout -issuer -nameopt RFC2253 | sed 's/^issuer=//')
ca=$(openssl x509 -in "$T/bundle.pem" -noout -subject -nameopt RFC2253 | sed 's/^subject=//')
grep -q 'O=SPIRE' <<<"$subj" && echo "PASS: subject has O = SPIRE" || { echo "FAIL: subject $subj"; rc=1; }
[ "$iss" = "$ca" ] && echo "PASS: issuer is the SPIRE server CA ($ca)" || { echo "FAIL: issuer '$iss' is not the SPIRE CA '$ca'"; rc=1; }
openssl verify -CAfile "$T/bundle.pem" -untrusted "$T/chain.pem" "$T/chain.pem" >/dev/null 2>&1 && echo "PASS: chain verifies against the SPIRE bundle" || { echo "FAIL: chain does not verify against the SPIRE bundle"; rc=1; }
san=$(openssl x509 -in "$T/chain.pem" -noout -ext subjectAltName | grep -o 'URI:spiffe://[^, ]*' | sed 's/^URI://')
svid=$(fetch_svid "$DATA" ev-client | jq -r '.svids[0].spiffe_id')
echo "URI SAN $san; SVID over the socket $svid"
[ -n "$san" ] && [ "$san" = "$svid" ] && echo "PASS: URI SAN equals the SVID" || { echo "FAIL: URI SAN differs from the SVID"; rc=1; }
fps() { pem_fingerprints "$1"; }
r=$(fps "$T/root.pem" | xargs); b=$(fps "$T/bundle.pem" | xargs)
echo "ROOTCA CA fingerprints: ${r:-none}"; echo "SPIRE bundle fingerprints: $b"
[ -n "$r" ] && [ "$r" = "$b" ] && echo "PASS: the ROOTCA bundle is the SPIRE server's CA" || { echo "FAIL: ROOTCA is not the SPIRE server's CA"; rc=1; }
evidence_section_passed mesh-identity-issued-by-spire || { echo "FAIL: the proof's evidence does not show it"; rc=1; }
exit $rc
