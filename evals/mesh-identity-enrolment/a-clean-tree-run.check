#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A clean-tree run
# level: L1
# requirement: The evidence is regenerated by the script, dated and versioned
. "$(dirname "$0")/../lib.sh"
E=$REPO/docs/evidences/mesh-identity
c=$(jq -r .commit "$E/environment.json"); d=$(jq -r .dirty "$E/environment.json")
echo "environment.json: commit=$c dirty=$d"
rc=0
git -C "$REPO" merge-base --is-ancestor "$c" HEAD 2>/dev/null || { echo "FAIL: $c is not a commit of this branch"; exit 1; }
[ "$d" = false ] || { echo "FAIL: dirty is $d"; rc=1; }
# The code commit: the last commit that changed anything but markdown, evidence or evals.
code=$(git -C "$REPO" log -1 --format=%H -- . ':(exclude)*.md' ':(exclude)docs/evidences/**' ':(exclude)evals/**')
later=$(git -C "$REPO" diff --name-only "$c" HEAD -- . ':(exclude)*.md' ':(exclude)docs/evidences/**' ':(exclude)evals/**')
echo "last code commit: $code"
[ -z "$later" ] || { echo "FAIL: code changed after the recorded commit:"; echo "$later"; rc=1; }
p=$(grep -c '^- PASS' "$E/evidence.md"); f=$(grep -c '^- \*\*FAIL' "$E/evidence.md")
echo "evidence.md: $p PASS lines, $f FAIL mentions; result.failures=$(jq -r .result.failures "$E/environment.json")"
[ "$p" -gt 0 ] && [ "$f" -eq 0 ] || { echo "FAIL: not every check is listed as passed"; grep -n '^- \*\*FAIL' "$E/evidence.md" | head; rc=1; }
exit $rc
