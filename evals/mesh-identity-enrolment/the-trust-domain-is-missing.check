#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / The trust domain is missing
# level: L1
# requirement: istiod takes the mesh trust domain and its certificates from SPIRE, with native sidecars
. "$(dirname "$0")/../lib.sh"
# The kind zone file with zone.trustDomain removed: the values the istiod release is rendered from.
python3 - "$KIND_ZONE" "$EVAL_TMP/zone.yaml" <<'PY'
import sys, yaml
v = yaml.safe_load(open(sys.argv[1])); v["zone"].pop("trustDomain", None)
yaml.safe_dump(v, open(sys.argv[2], "w"))
PY
out=$(ZONE_VALUES=$EVAL_TMP/zone.yaml RENDER_DIR=$EVAL_TMP/r "$INSTALL" render istiod 2>&1); rc=$?
echo "render istiod without zone.trustDomain: exit $rc"; echo "$out" | tail -5
[ $rc -ne 0 ] || { echo "FAIL: expected rendering to fail, it exited 0"; exit 1; }
grep -q 'zone\.trustDomain' <<<"$out" || { echo "FAIL: message does not name the zone fact zone.trustDomain"; exit 1; }
echo "PASS: refused, naming zone.trustDomain"
