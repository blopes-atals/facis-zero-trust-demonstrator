#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A step fails
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
need_kind
ensure_empty
install_zone install STEP_TIMEOUT=2s; cat "$EVAL_TMP/inst.out" "$EVAL_TMP/inst.err" | tail -30
[ $rc -ne 0 ] || { echo "FAIL: expected non-zero exit with a 2s step timeout"; exit 1; }
named=$(cat "$EVAL_TMP/inst.out" "$EVAL_TMP/inst.err" | grep -oE "release ($(tr ' ' '|' <<<"$SEVEN"))\b" | head -1)
[ -n "$named" ] || { echo "FAIL: the output does not name the failing release"; exit 1; }
echo "named: $named"
n=$(releases_installed | wc -l); [ "$n" -lt 7 ] || { echo "FAIL: all seven releases installed; the run did not stop"; exit 1; }
echo "PASS: stopped with exit $rc, $n release(s) present"
