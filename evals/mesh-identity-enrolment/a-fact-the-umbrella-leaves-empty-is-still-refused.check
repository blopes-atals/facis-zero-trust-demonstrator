#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A fact the umbrella leaves empty is still refused
# level: L1
# requirement: A release's zone facts are the umbrella's defaults with the zone file on top
. "$EVAL_ROOT/evals/lib.sh"
zone_with nosc "d['zone'].pop('storageClass',None)"
for rel in spire ztd-openbao; do
  cache; rm -rf "$EVAL_TMP/out"; mkdir -p "$EVAL_TMP/out"
  out=$(ZONE_VALUES=$EVAL_TMP/nosc.yaml RENDER_DIR=$EVAL_TMP/out "$INSTALL" render $rel 2>&1); rc=$?
  echo "[$rel rc=$rc] $out" | head -4
  [ $rc -ne 0 ] || { echo "$rel: expected non-zero"; exit 1; }
  grep -q 'storageClass' <<<"$out" && grep -q "$rel" <<<"$out" || { echo "$rel: message must name storageClass and the release"; exit 1; }
  [ ! -e "$EVAL_TMP/out/$rel.yaml" ] || { echo "$rel rendered anyway"; exit 1; }
done
