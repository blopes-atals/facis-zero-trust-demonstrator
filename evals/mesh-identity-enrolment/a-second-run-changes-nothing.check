#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A second run changes nothing
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$(dirname "$0")/../lib.sh"
need_state
S=$ZTD_STATE
echo "installer run #2: exit $(cat "$S/install2.rc")"
rc=0; [ "$(cat "$S/install2.rc")" = 0 ] || rc=1
for f in "$S"/m1/*.yaml; do
  r=$(basename "$f" .yaml)
  if [ ! -s "$f" ] || grep -q '^Error' "$f"; then echo "FAIL: $r: no manifest after run #1"; rc=1; continue; fi
  if cmp -s "$f" "$S/m2/$r.yaml"; then echo "identical: $r ($(wc -l < "$f") lines)"; else echo "FAIL: $r differs:"; diff "$f" "$S/m2/$r.yaml" | head -10; rc=1; fi
done
[ "$(ls "$S"/m1/*.yaml | wc -l)" -eq 7 ] || { echo "FAIL: expected 7 releases"; rc=1; }
exit $rc
