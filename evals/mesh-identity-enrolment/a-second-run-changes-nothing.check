#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A second run changes nothing
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
rc=$(cat "$(setup_file install2.rc)"); echo "second install exit code: $rc"
[ "$rc" = 0 ] || { tail -8 "$SETUP_DIR/install2.log"; exit 1; }
n=$(wc -l < "$SETUP_DIR/manifests1.txt"); [ "$n" -eq 8 ] || { echo "expected 8 manifests, got $n"; exit 1; }
diff "$SETUP_DIR/manifests1.txt" "$SETUP_DIR/manifests2.txt" || { echo "manifests differ between the runs"; exit 1; }
grep -q '^ztd-openbao ' "$SETUP_DIR/manifests1.txt" || { echo "ztd-openbao manifest not recorded"; exit 1; }
bad=$(pods_not_ready spire-system istio-system $MGMT ztd-data); [ -z "$bad" ] || { echo "pods not Ready: $bad"; exit 1; }
echo "eight manifests identical, every pod Ready"
