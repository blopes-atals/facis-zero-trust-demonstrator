#!/usr/bin/env bash
# scenario: mesh-identity-enrolment / A second run changes nothing
# level: L2
# requirement: A zone installs from an empty cluster in one order, idempotently
. "$EVAL_ROOT/evals/mesh-identity-enrolment/_lib.sh"
need_kind
snap() { mkdir -p "$1"; while read -r ns name; do
  helm --kube-context "$CTX" get manifest -n "$ns" "$name" >"$1/$name.yaml"; done \
  < <(helm --kube-context "$CTX" list -A -o json | python3 -c 'import json,sys; [print(r["namespace"], r["name"]) for r in json.load(sys.stdin)]'); }
[ -n "$(releases_installed)" ] || { install_zone install; [ $rc -eq 0 ] || { tail -20 "$EVAL_TMP/inst.err"; echo "FAIL: first install exited $rc"; exit 1; }; }
snap "$EVAL_TMP/first"
install_zone install; tail -20 "$EVAL_TMP/inst.out" "$EVAL_TMP/inst.err"
[ $rc -eq 0 ] || { echo "FAIL: second run exited $rc"; exit 1; }
snap "$EVAL_TMP/second"
for r in $SEVEN; do [ -s "$EVAL_TMP/first/$r.yaml" ] || { echo "FAIL: release $r missing after the first run"; exit 1; }; done
diff -r "$EVAL_TMP/first" "$EVAL_TMP/second" && echo "PASS: every manifest identical" || { echo "FAIL: manifests differ"; exit 1; }
