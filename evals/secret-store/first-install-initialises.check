#!/usr/bin/env bash
# scenario: secret-store / First install initialises
# level: L2
# requirement: The bootstrap reaches a sealed server and reruns when the server may restart
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
keys=$(k -n "$MGMT" get secret ztd-openbao-bootstrap -o json | jq -r '.data|keys|join(",")'); echo "Secret keys: $keys"
case ",$keys," in *,unseal-key,*) ;; *) echo "no unseal-key"; exit 1;; esac
case ",$keys," in *,verify-token,*) ;; *) echo "no verify-token"; exit 1;; esac
case ",$keys," in *,root-token,*) echo "root token still stored"; exit 1;; esac
st=$(k -n "$MGMT" exec ztd-openbao-0 -c openbao -- bao status -format=json)
jq -e '.initialized==true and .sealed==false' <<<"$st" >/dev/null || { echo "server not initialised and unsealed"; exit 1; }
# the stored root token must be gone, and the log of the Job says so
log=$(job_log "$(k -n "$MGMT" get jobs -o name | grep bootstrap- | head -1 | sed 's#.*/##')")
grep -q 'initialised' <<<"$log" && grep -q 'root token revoked' <<<"$log" || { echo "bootstrap log does not show init and root revocation"; echo "$log" | tail -5; exit 1; }
# the verification token must not be a root token
tok=$(k -n "$MGMT" get secret ztd-openbao-bootstrap -o jsonpath='{.data.verify-token}' | base64 -d)
pol=$(printf '%s' "$tok" | k -n "$MGMT" exec -i ztd-openbao-0 -c openbao -- sh -c 'read -r t; BAO_TOKEN=$t bao token lookup -format=json' | jq -r '.data.policies|join(",")')
echo "verification token policies: $pol"
case ",$pol," in *,root,*) echo "verification token is root"; exit 1;; esac
