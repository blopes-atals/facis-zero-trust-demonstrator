#!/usr/bin/env bash
# scenario: secret-store / The hook passes on a healthy store
# level: L2
# requirement: The verification hook proves the store after every install and upgrade
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
log=$(job_log ztd-verify-openbao verify); echo "$log"
for c in "initialised and unsealed" "secret/ is kv version 2" "transit/ is transit"; do
  grep -q "^ok .*$c" <<<"$log" || { echo "check not logged ok: $c"; exit 1; }
done
grep -qx 'OpenBao verified' <<<"$log" || exit 1
# no value printed: the fixture value must not appear, only a hash
grep -q 'sha256' <<<"$log" || { echo "no hash of the fixture value"; exit 1; }
s=$(helm --kube-context kind-ztd status ztd-openbao -n "$MGMT" -o json | jq -r .info.status); [ "$s" = deployed ] || { echo "release $s"; exit 1; }
