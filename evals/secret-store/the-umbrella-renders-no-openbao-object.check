#!/usr/bin/env bash
# scenario: secret-store / The umbrella renders no OpenBao object
# level: L1
# requirement: OpenBao is a release of its own, installed after the registration rule
. "$EVAL_ROOT/evals/lib.sh"
for z in "$KIND_ZONE" "$ZONES/zone-a.yaml" "$ZONES/zone-b.yaml" "$ZONES/ionos.yaml"; do
  out=$(helm template ztd "$EVAL_ROOT/deployment/helm/ztd" -n ztd-system -f "$z" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    # the stale-key refusal must not be what fails; other render needs are reported
    echo "render of $(basename "$z") failed: $(head -3 <<<"$out")"; exit 1
  fi
  bad=$(python3 -c '
import sys, yaml
for d in yaml.safe_load_all(sys.stdin):
    if not d: continue
    n = d["metadata"].get("name", "")
    if d["kind"] in ("StatefulSet","Service","Job","ServiceAccount","Role") and "openbao" in n and "standin" not in n:
        print(d["kind"], n)
' <<<"$out")
  echo "$(basename "$z"): OpenBao objects: ${bad:-none}"
  [ -z "$bad" ] || exit 1
done
if grep -q 'openbao' "$EVAL_ROOT/deployment/helm/ztd/Chart.lock" 2>/dev/null; then echo "umbrella Chart.lock lists openbao"; exit 1; fi
grep -q 'openbao' "$EVAL_ROOT/deployment/helm/ztd/Chart.yaml" && grep -v '^\s*#' "$EVAL_ROOT/deployment/helm/ztd/Chart.yaml" | grep -q 'name: openbao' && { echo "umbrella Chart.yaml declares openbao"; exit 1; }
echo ok
