#!/usr/bin/env bash
# scenario: secret-store / The hook fails on a sealed store
# level: L2
# requirement: The verification hook proves the store after every install and upgrade
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
trap '"$EVAL_ROOT/scripts/secrets/unseal.sh" "$MGMT" ztd-openbao-0 >/dev/null 2>&1; rm_copies' EXIT
k -n "$MGMT" delete pod ztd-openbao-0 --wait=true >/dev/null
end=$(( $(date +%s) + 180 ))
until [ "$(k -n "$MGMT" get pod ztd-openbao-0 -o jsonpath='{.status.phase}' 2>/dev/null)" = Running ]; do [ "$(date +%s)" -lt "$end" ] || { echo "pod did not restart"; exit 1; }; sleep 3; done
sleep 8
sealed=$(k -n "$MGMT" exec ztd-openbao-0 -c openbao -- bao status -format=json 2>/dev/null | jq -r .sealed); echo "sealed after restart: $sealed"
[ "$sealed" = true ] || { echo "precondition: server should be sealed"; exit 1; }
job_copy ztd-verify-openbao ztd-verify-openbao-sealed
wait_job ztd-verify-openbao-sealed failed 180; w=$?
log=$(job_log ztd-verify-openbao-sealed verify); echo "$log"
[ $w -eq 0 ] || { echo "the hook did not fail (wait=$w)"; exit 1; }
grep -q 'FAIL' <<<"$log" || { echo "no failed health check logged"; exit 1; }
grep -q 'unseal.sh' <<<"$log" || { echo "no pointer to the unseal script"; exit 1; }
