#!/usr/bin/env bash
# scenario: secret-store / An upgrade that restarts the server unseals it
# level: L2
# requirement: The bootstrap reaches a sealed server and reruns when the server may restart
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
chart_copy
helm --kube-context kind-ztd get values ztd-openbao -n "$MGMT" -o yaml > "$EVAL_TMP/values.yaml"
old=$(k -n "$MGMT" get jobs -o name | grep bootstrap- | sed 's#.*/##' | head -1)
uid0=$(k -n "$MGMT" get pod ztd-openbao-0 -o jsonpath='{.metadata.uid}')
up() { helm --kube-context kind-ztd upgrade ztd-openbao "$EVAL_TMP/chart" -n "$MGMT" -f "$EVAL_TMP/values.yaml" "$@" --wait --wait-for-jobs --timeout 8m; }
out=$(up --set openbao.server.resources.limits.memory=384Mi 2>&1); rc=$?
echo "$out" | tail -3
new=$(k -n "$MGMT" get jobs -o name | grep bootstrap- | sed 's#.*/##' | head -1)
uid1=$(k -n "$MGMT" get pod ztd-openbao-0 -o jsonpath='{.metadata.uid}')
st=$(helm --kube-context kind-ztd status ztd-openbao -n "$MGMT" -o json | jq -r .info.status)
sealed=$(k -n "$MGMT" exec ztd-openbao-0 -c openbao -- bao status -format=json | jq -r .sealed)
echo "job $old -> $new; pod uid changed: $([ "$uid0" != "$uid1" ] && echo yes || echo no); release $st; sealed=$sealed"
up >/dev/null 2>&1   # put the original values back
[ $rc -eq 0 ] && [ "$st" = deployed ] || { echo "upgrade did not reach deployed"; exit 1; }
[ "$uid0" != "$uid1" ] || { echo "the server did not restart"; exit 1; }
[ "$new" != "$old" ] || { echo "no new bootstrap Job name"; exit 1; }
[ "$sealed" = false ] || { echo "server still sealed"; exit 1; }
