#!/usr/bin/env bash
# scenario: secret-store / An unpinned dependency is refused
# level: L1
# requirement: The chart carries the upstream server as its locked dependency
. "$EVAL_ROOT/evals/lib.sh"
git -C "$EVAL_ROOT" rev-parse HEAD >/dev/null 2>&1 || exit 77
clone=$EVAL_TMP/clone; mkdir -p "$clone"
git -C "$EVAL_ROOT" archive HEAD | tar -x -C "$clone"
pin=$clone/deployment/helm/ztd-openbao/dependencies.sha256
export INSTALL_ZONE_CACHE=$EVAL_TMP/cache; mkdir -p "$INSTALL_ZONE_CACHE"   # private, cold cache
run() {  # run <tag>: render ztd-openbao from the clone; sets RC, OUT
  rm -rf "$EVAL_TMP/out"; mkdir -p "$EVAL_TMP/out"
  OUT=$(ZONE_VALUES=$clone/deployment/helm/ztd/ci/values.yaml RENDER_DIR=$EVAL_TMP/out timeout 300 "$clone/scripts/install-zone/install.sh" render ztd-openbao 2>&1); RC=$?
}
# baseline: the genuine dependency is built into the cache and renders
run
if [ $RC -ne 0 ]; then
  grep -qi 'could not resolve\|no such host\|connection\|timeout\|dial tcp\|Temporary failure\|unreachable' <<<"$OUT" && { echo "no network to the chart repository"; exit 77; }
  echo "baseline render failed rc=$RC: $(tail -3 <<<"$OUT")"; exit 1
fi
deps=$(ls -d "$INSTALL_ZONE_CACHE"/ztd-openbao-deps-* | head -1)
refused() {  # refused <case>: the last run must have stopped, named the chart and rendered nothing
  echo "[$1 rc=$RC] $(tail -2 <<<"$OUT" | cut -c1-300)"
  [ $RC -ne 0 ] || { echo "$1: expected the installer to stop"; exit 1; }
  grep -q 'ztd-openbao' <<<"$OUT" || { echo "$1: message does not name the chart"; exit 1; }
  [ ! -s "$EVAL_TMP/out/ztd-openbao.yaml" ] || { echo "$1: something was rendered"; exit 1; }
}
# 1. the committed pin differs from the built archive
cp "$pin" "$EVAL_TMP/pin.orig"
printf '%064d  openbao-0.28.3.tgz\n' 0 > "$pin"
run; refused "pin differs"
cp "$EVAL_TMP/pin.orig" "$pin"
# 2. the built archive's bytes differ from the pin
arch=$(ls "$deps"/chart/charts/*.tgz | head -1)
cp "$arch" "$EVAL_TMP/arch.orig"; printf 'x' >> "$arch"
run; refused "archive bytes differ"
cp "$EVAL_TMP/arch.orig" "$arch"
# 3. charts/ holds something the pin does not list
printf 'x' > "$deps/chart/charts/extra-1.0.0.tgz"
run; refused "unlisted file in charts/"
rm -f "$deps/chart/charts/extra-1.0.0.tgz"
# control: restored state renders again
run; [ $RC -eq 0 ] || { echo "control render failed rc=$RC"; exit 1; }
