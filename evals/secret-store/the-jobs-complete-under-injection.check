#!/usr/bin/env bash
# scenario: secret-store / The jobs complete under injection
# level: L2
# requirement: The server and its jobs are created as declared workloads
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
for job in $(k -n "$MGMT" get jobs -o name | sed 's#.*/##'); do
  st=$(k -n "$MGMT" get job "$job" -o jsonpath='{.status.conditions[?(@.type=="Complete")].status}')
  [ "$st" = True ] || { echo "job $job not complete"; exit 1; }
  pod=$(k -n "$MGMT" get pods -l job-name="$job" -o name | head -1)
  phase=$(k -n "$MGMT" get "$pod" -o jsonpath='{.status.phase}')
  side=$(k -n "$MGMT" get "$pod" -o json | jq -r '[.spec.initContainers[]? | select(.name=="istio-proxy" and .restartPolicy=="Always")] | length')
  echo "$job: $pod phase=$phase native-sidecar=$side"
  [ "$phase" = Succeeded ] && [ "$side" = 1 ] || exit 1
done
[ -n "$(k -n "$MGMT" get jobs -o name)" ] || { echo "no jobs"; exit 1; }
k -n "$MGMT" get job -o name | grep -q ztd-openbao-bootstrap || { echo "no bootstrap job"; exit 1; }
k -n "$MGMT" get job -o name | grep -q ztd-verify-openbao || { echo "no verification job"; exit 1; }
s=$(helm --kube-context kind-ztd status ztd-openbao -n "$MGMT" -o json | jq -r .info.status); echo "release status: $s"
[ "$s" = deployed ] || exit 1
