#!/usr/bin/env bash
# scenario: secret-store / A reviewer looks for the deviation
# level: L1
# requirement: The manual unseal after a restart is a declared reading
. "$EVAL_ROOT/evals/lib.sh"
f=$EVAL_ROOT/docs/specifications.md
[ -f "$f" ] || { echo "missing docs/specifications.md"; exit 1; }
row=$(grep -i 'unseal' "$f" | grep -i 'zero manual\|manual intervention' | head -1)
echo "row: ${row:0:300}"
[ -n "$row" ] || { echo "no row naming the TDR rule and the unseal"; exit 1; }
grep -q 'secrets.md' <<<"$row" || { echo "row does not point to the secrets page"; exit 1; }
grep -q 'unseal.sh' <<<"$row" || { echo "row does not point to the unseal script"; exit 1; }
grep -qi 'restart' <<<"$row" || { echo "row does not mention a restart"; exit 1; }
s=$EVAL_ROOT/docs/secrets.md
grep -qi 'restart' "$s" && grep -qi 'bootstrap' "$s" || { echo "docs/secrets.md does not state which restarts the bootstrap covers"; exit 1; }
