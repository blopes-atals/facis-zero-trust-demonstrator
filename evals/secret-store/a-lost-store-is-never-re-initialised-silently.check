#!/usr/bin/env bash
# scenario: secret-store / A lost store is never re-initialised silently
# level: L2
# requirement: The bootstrap reaches a sealed server and reruns when the server may restart
. "$EVAL_ROOT/evals/lib.sh"
need_cluster
rc=0
trap 'restore_store >"$EVAL_TMP/restore.out" 2>&1 || echo "WARNING: store restore failed: $(tail -3 "$EVAL_TMP/restore.out")"; rm_copies' EXIT
# Case 1: the server is not initialised (empty volume) but the Secret exists.
wipe_store || exit 1
job_copy ztd-openbao-bootstrap- ztd-openbao-bootstrap-lost1
wait_job ztd-openbao-bootstrap-lost1 failed 240; w=$?
log=$(job_log ztd-openbao-bootstrap-lost1); echo "--- case 1 log"; echo "$log" | tail -6
[ $w -eq 0 ] || { echo "case 1: the Job did not fail (wait=$w)"; exit 1; }
grep -qi 'lost\|not initiali' <<<"$log" && grep -qi 'recover\|docs/secrets' <<<"$log" || { echo "case 1: log does not name the condition and the recovery"; exit 1; }
# Case 2: the server is initialised and the Secret is missing.
restore_store || exit 1
k -n "$MGMT" delete secret ztd-openbao-bootstrap >/dev/null
job_copy ztd-openbao-bootstrap- ztd-openbao-bootstrap-lost2
wait_job ztd-openbao-bootstrap-lost2 failed 240; w=$?
log=$(job_log ztd-openbao-bootstrap-lost2); echo "--- case 2 log"; echo "$log" | tail -6
[ $w -eq 0 ] || { echo "case 2: the Job did not fail (wait=$w)"; exit 1; }
grep -qi 'secret' <<<"$log" && grep -qi 'initiali' <<<"$log" && grep -qi 'recover\|docs/secrets\|never' <<<"$log" || { echo "case 2: log does not name the condition and the recovery"; exit 1; }
n=$(k -n "$MGMT" get secret ztd-openbao-bootstrap 2>/dev/null | wc -l); [ "$n" -eq 0 ] || { echo "the Secret was re-created silently"; exit 1; }
echo ok
