#!/usr/bin/env python3
# scenario: plane-separation-design / The prose under the heading is read alone
# level: L1
# requirement: Diagram 03 reflects the plane-separation model
import os, re, sys
sys.path.insert(0, os.path.join(os.environ.get("EVAL_ROOT", "."), "evals/lib"))
from diagram03 import *

sec = section(read(ARCH), "Trust boundaries (diagram 03)")
prose = norm("\n".join(l for l in sec.splitlines() if not l.startswith("![") and not l.startswith("Source:")))
print("prose:", prose)
p = prose.lower()
checks = {
    "each zone is one cluster and its own SPIFFE trust domain":
        re.search(r"each (trust )?zone is one cluster and its own spiffe trust domain", p),
    "placed management-plane components run inside the zone's trust domain":
        re.search(r"placement[^.]*record[^.]*inside the zone's trust domain", p),
    "separation is a namespace and policy boundary rather than an identity boundary":
        re.search(r"namespace and policy boundary,? (not|rather than) an identity boundary", p),
    "data-plane calls into the management plane denied by default at both layers":
        re.search(r"data-plane calls into the management plane are denied by default at both[^.]*networkpolicy[^.]*mesh", p),
    "permitted only along the allow matrix's paths":
        re.search(r"permitted only along the paths the allow matrix|permitted only along the allow matrix", p),
    "components without recorded placement drawn outside both zones under the same rule":
        re.search(r"placement is not yet recorded[^.]*outside both zones under the same rule", p),
}
fails = [k for k, ok in checks.items() if not ok]
for s in sentences(prose):
    if "observability" in s.lower() and "control channel" in s.lower():
        fails.append(f"calls the observability export a control channel: {s!r}")
if fails:
    die("FAIL, prose does not state:\n  " + "\n  ".join(fails))
print("PASS: the paragraph states the model in words and does not call the export a control channel")
