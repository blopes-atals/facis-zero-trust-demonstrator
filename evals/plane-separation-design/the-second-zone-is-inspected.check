#!/usr/bin/env python3
# scenario: plane-separation-design / The second zone is inspected
# level: L1
# requirement: Diagram 03 reflects the plane-separation model
import os, re, sys
sys.path.insert(0, os.path.join(os.environ.get("EVAL_ROOT", "."), "evals/lib"))
from diagram03 import *

g = diagram()
tds = g.trust_domains()
print("trust domains:", {t: g.subgraphs[t] for t in tds})
if len(tds) != 2:
    die(f"expected 2 SPIFFE trust domain groupings (zone-a, zone-b), got {len(tds)}")
labels = {}
fails = []
for td in tds:
    dps, mps = g.data_plane(td), g.mgmt_plane(td)
    if len(dps) != 1 or len(mps) != 1:
        fails.append(f"{td}: expected one data-plane and one management-plane grouping, got dp={dps} mp={mps}")
        continue
    e = [lab for (s, k, lab, t) in g.edges if s == dps[0] and t == mps[0]]
    if not e:
        fails.append(f"{td}: no edge from data plane to management plane")
        continue
    labels[td] = e[0]
    # no zone without a management-plane relationship
    rel = [t for (s, k, lab, t) in g.edges if s == dps[0] and "management plane" in g.nodes.get(t, "").lower()]
    print(f"{td}: dp={g.nodes[dps[0]]!r} mp={g.nodes[mps[0]]!r} mgmt edges -> {rel}")
    if not rel:
        fails.append(f"{td}: zone drawn without a management-plane relationship")
# same groupings
mp_labels = {td: g.nodes[g.mgmt_plane(td)[0]] for td in tds if len(g.mgmt_plane(td)) == 1}
dp_labels = {td: g.nodes[g.data_plane(td)[0]] for td in tds if len(g.data_plane(td)) == 1}
if len(set(mp_labels.values())) > 1:
    fails.append(f"management-plane groupings differ between zones: {mp_labels}")
if len(set(dp_labels.values())) > 1:
    fails.append(f"data-plane groupings differ between zones: {dp_labels}")
if len(labels) == 2 and len(set(labels.values())) != 1:
    fails.append(f"intra-zone edges differ between zones: {labels}")
if fails:
    die("FAIL:\n  " + "\n  ".join(fails))
print("PASS: both zones carry the same groupings and the same edge")
