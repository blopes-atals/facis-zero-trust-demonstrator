#!/usr/bin/env bash
# scenario: workload-identity / An entry held by a pod with its certificate is matched
# level: L1
# requirement: The proof records the registration inventory by SPIFFE ID
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

z = Zone(); z.namespace("data")
u = z.pod("data", "web", sa="web")
eid = f"spiffe://{TD}/ns/data/sa/web"
z.entry("/ns/data/sa/web", u); z.cert("data", "web", eid)
rep, ch = z.run(); show(rep, ch)
r = row(rep, eid)
expect(r, "no row for the entry")
expect(any("data/web" in x and "matched" in x and "without" not in x for x in r), "row must show the pod and outcome matched")
expect(eid in r[0], "certificate SPIFFE ID printed")
expect(not failed(ch), "no failure expected")
print("entry, pod and certificate ID printed with outcome matched")
PYEOF
