#!/usr/bin/env bash
# scenario: workload-identity / A healthy install passes the checks
# level: L2
# requirement: Identity-band checks fail the release when identity is not there
. "$(dirname "$0")/../lib.sh"
need_live
S=$ZTD_STATE; rc=0
grep -q 'wait-for-jobs' "$S/install3.log" && echo "installer ran zone-policy with --wait-for-jobs"
st=$(jq -r .info.status "$S/zp-status3.json"); echo "zone-policy after install: $st"
[ "$st" = deployed ] || rc=1
python3 - "$S/zp-hooks3.yaml" "$S/jobs3.json" <<'PY' || rc=1
import sys, yaml, json
hooks = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d and d.get("kind") == "Job"]
jobs = {j["metadata"]["name"] for j in json.load(open(sys.argv[2]))["items"]}
ok = True
for h in hooks:
    a = h["metadata"].get("annotations", {})
    w = int(a.get("helm.sh/hook-weight", "-1"))
    left = h["metadata"]["name"] in jobs
    print(f"hook job {h['metadata']['name']}: {a.get('helm.sh/hook')} weight {w} delete-policy {a.get('helm.sh/hook-delete-policy')} still present: {left}")
    ok &= 20 <= w <= 39 and "post-install" in a.get("helm.sh/hook", "") and "post-upgrade" in a.get("helm.sh/hook", "") and not left
print("PASS" if ok and hooks else "FAIL: want identity-band (20-39) post-install/post-upgrade jobs, run and removed")
sys.exit(0 if ok and hooks else 1)
PY
exit $rc
