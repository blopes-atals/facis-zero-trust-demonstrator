#!/usr/bin/env bash
# scenario: workload-identity / No SPIRE pod has a sidecar
# level: L2
# requirement: The identity control plane is a management-plane namespace under the default deny
. "$(dirname "$0")/../lib.sh"
need_live
out=$(k -n "$SPIRE_NS" get pods -o json | jq -r '.items[] | "\(.metadata.name): \([(.spec.initContainers // [])[].name, .spec.containers[].name] | join(","))"')
echo "$out"
[ -n "$out" ] || { echo "FAIL: no pod in $SPIRE_NS"; exit 1; }
grep -q istio-proxy <<<"$out" && { echo "FAIL: a SPIRE pod has istio-proxy"; exit 1; }
echo PASS
