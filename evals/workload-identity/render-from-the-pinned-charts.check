#!/usr/bin/env bash
# scenario: workload-identity / Render from the pinned charts
# level: L1
# requirement: SPIRE is installed into a zone as pinned upstream releases
. "$(dirname "$0")/../lib.sh"
render_all "$EVAL_TMP/r" || { echo "FAIL: install.sh render failed"; tail -20 "$EVAL_TMP/r.log"; exit 1; }
python3 - "$EVAL_TMP/r" <<'PY'
import sys, yaml
d = sys.argv[1]
load = lambda p: [x for x in yaml.safe_load_all(open(p)) if x]
crds, spire = load(f"{d}/spire-crds.yaml"), load(f"{d}/spire.yaml")
fails = []
def ok(c, m):
    print(("PASS: " if c else "FAIL: ") + m)
    if not c: fails.append(m)
crd = [x["metadata"]["name"] for x in crds if x["kind"] == "CustomResourceDefinition"]
ok(any(n.endswith(".spire.spiffe.io") for n in crd), f"SPIRE CRDs: {crd}")
sts = [x for x in spire if x["kind"] == "StatefulSet"]
ok(any("server" in x["metadata"]["name"] for x in sts), f"server StatefulSet: {[x['metadata']['name'] for x in sts]}")
ds = {x["metadata"]["name"]: x for x in spire if x["kind"] == "DaemonSet"}
agent = next((v for n, v in ds.items() if "agent" in n), None)
ok(agent is not None, f"agent DaemonSet among {list(ds)}")
if agent: ok(agent["spec"]["template"]["spec"].get("hostNetwork") is True, f"agent hostNetwork={agent['spec']['template']['spec'].get('hostNetwork')}")
csi = [x["metadata"]["name"] for x in spire if x["kind"] == "CSIDriver"]
ok("csi.spiffe.io" in csi and any("csi" in n for n in ds), f"CSI driver: CSIDriver {csi}, DaemonSets {list(ds)}")
cms = [c["name"] for x in spire if x["kind"] in ("StatefulSet", "Deployment") for c in x["spec"]["template"]["spec"]["containers"]]
ok(any("controller-manager" in c for c in cms), f"controller-manager container among {cms}")
ns = [x["metadata"]["name"] for x in crds + spire if x["kind"] == "Namespace"]
ok(not ns, f"no Namespace resource: {ns}")
sys.exit(1 if fails else 0)
PY
