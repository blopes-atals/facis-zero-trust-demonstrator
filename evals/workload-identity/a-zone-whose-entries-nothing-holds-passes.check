#!/usr/bin/env bash
# scenario: workload-identity / A zone whose entries nothing holds passes
# level: L1
# requirement: A certificate the proof cannot read fails the run
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

# every entry's pod is gone or holds no certificate, every read answered
z = Zone(); z.namespace("data")
z.entry("/ns/data/sa/gone", "uid-of-a-deleted-pod")
u = z.pod("data", "idle", sa="idle"); z.entry("/ns/data/sa/idle", u)
z.cert("data", "idle", status="none")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), f"entries nothing holds must add no failure, got {len(failed(ch))}")
# stopped reader (container not running) answers too
z = Zone(); z.namespace("data")
u = z.pod("data", "st", sa="st"); z.entry("/ns/data/sa/st", u); z.cert("data", "st", status="stopped")
rep, ch = z.run(); expect(not failed(ch), "a stopped reader adds no failure")
# the server lists no entry
z = Zone(); z.namespace("data")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), "an empty server must add no failure")
print("no failure with unheld entries, stopped readers or an empty server")
PYEOF
