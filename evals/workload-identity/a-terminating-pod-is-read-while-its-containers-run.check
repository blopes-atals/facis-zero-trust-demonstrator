#!/usr/bin/env bash
# scenario: workload-identity / A terminating pod is read while its containers run
# level: L1
# requirement: No pod escapes the certificate read by being deleted or by its own data
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
V="$EVAL_ROOT/scripts/verify-mesh-identity/verify.sh"
python3 - "$V" <<'PYEOF'
import json, os, re, subprocess, sys, tempfile
from inv_lib import expect, Zone, show, failed
src = open(sys.argv[1]).read()
m = re.search(r"python3 - \"\$inv/namespaces.json\" \"\$inv/pods.json\"[^\n]*<<'PY'\n(.*?)\nPY\n", src, re.S)
expect(m, "cannot locate the reader listing in verify.sh")
d = tempfile.mkdtemp(dir=os.environ.get("EVAL_TMP"))
json.dump({"items": [{"metadata": {"name": "data", "labels": {"ztd.facis.io/plane": "data"}}}]}, open(d + "/ns.json", "w"))
def pod(name, term):
    md = {"namespace": "data", "name": name, "uid": "u-" + name}
    if term: md["deletionTimestamp"] = "2026-01-01T00:00:00Z"
    return {"metadata": md, "spec": {"containers": [{"name": "app", "image": "x"}, {"name": "istio-proxy", "image": "p"}]},
            "status": {"phase": "Running", "containerStatuses": [{"name": "istio-proxy", "state": {"running": {}}}]}}
json.dump({"items": [pod("term", True), pod("norm", False)]}, open(d + "/pods.json", "w"))
open(d + "/l.py", "w").write(m.group(1))
r = subprocess.run([sys.executable, d + "/l.py", d + "/ns.json", d + "/pods.json"], capture_output=True, text=True)
print(r.stdout, r.stderr)
rows = [l.split("\t") for l in r.stdout.splitlines()]
t = [x for x in rows if x[1] == "term"]
expect(t and t[0][2] == "proxy" and t[0][4] == "running", f"terminating pod with running proxy must be listed as running reader: {t}")
# comparison: read ok on terminating pod is compared like any other
z = Zone(); z.namespace("data")
u = z.pod("data", "term", sa="term"); z.entry("/ns/data/sa/term", u)
z.pods[0]["metadata"]["deletionTimestamp"] = "2026-01-01T00:00:00Z"
z.cert("data", "term", uri="spiffe://ztd.test/ns/data/sa/term")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), "terminating pod with a readable matching certificate adds no failure")
expect("matched" in rep, "terminating pod's entry must be matched")
# a read that fails because the reader stopped: recorded not running, no failure
z = Zone(); z.namespace("data")
u = z.pod("data", "term", sa="term"); z.entry("/ns/data/sa/term", u)
z.pods[0]["metadata"]["deletionTimestamp"] = "2026-01-01T00:00:00Z"
z.cert("data", "term", status="stopped")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), "stopped reader on a terminating pod adds no failure")
print("terminating pod read like any other; stopped reader no failure")
PYEOF
rc=$?; [ $rc -eq 0 ] || exit $rc
# the failure routing in the read loop: gone / ended / error
fn=$(sed -n '/^reader_ended() {/,/^}/p' "$V")
[ -n "$fn" ] || { echo "reader_ended not found"; exit 1; }
pj='{"metadata":{"uid":"u1","deletionTimestamp":"2026-01-01T00:00:00Z"},"status":{"containerStatuses":[{"name":"istio-proxy","state":{"terminated":{}}}]}}'
rc=$(bash -c "k() { echo '$pj'; }; $fn; reader_ended data p u1 istio-proxy; echo \$?" | tail -1)
[ "$rc" = 0 ] || { echo "FAIL: terminating pod with stopped reader should be ended, rc $rc"; exit 1; }
pj='{"metadata":{"uid":"u1","deletionTimestamp":"2026-01-01T00:00:00Z"},"status":{"containerStatuses":[{"name":"istio-proxy","state":{"running":{}}}]}}'
rc=$(bash -c "k() { echo '$pj'; }; $fn; reader_ended data p u1 istio-proxy; echo \$?" | tail -1)
[ "$rc" = 1 ] || { echo "FAIL: terminating pod with running reader and failed read must stand as failure, rc $rc"; exit 1; }
echo "reader_ended routes correctly"
