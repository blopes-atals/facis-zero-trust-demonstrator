#!/usr/bin/env bash
# scenario: workload-identity / Both exist in the same namespace
# level: L2
# requirement: The management-plane stand-in is not named after the real store
. "$EVAL_ROOT/evals/lib.sh"
f=$EVAL_ROOT/scripts/verify-mesh-identity/fixtures/stand-ins.yaml
python3 - "$f" <<'PY' || exit 1
import sys, yaml
docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d]
names = [(d["kind"], d["metadata"]["name"]) for d in docs]
print([n for n in names if "openbao" in n[1]])
assert ("Pod", "openbao-standin") in names, "stand-in pod is not named openbao-standin"
assert ("Service", "openbao-standin") in names, "stand-in Service is not named openbao-standin"
assert ("Pod", "openbao") not in names and ("Service", "openbao") not in names, "a stand-in is still named openbao"
assert ("Service", "ztd-openbao") not in names
PY
ev=$(setup_file evidence/evidence.md); rc=$(cat "$(setup_file verify.rc)")
[ "$rc" = 0 ] || { echo "verify.sh failure count $rc"; exit 1; }
grep -q -- '- PASS: data-plane pod → openbao-standin' "$ev" && grep -q -- '- PASS: pdp-adapter → openbao-standin' "$ev" || { echo "matrix checks do not target openbao-standin"; exit 1; }
grep -F 'ztd-openbao-0' "$ev" | grep -q Running || { echo "real store not running during the proof"; exit 1; }
grep -E '^openbao-standin ' "$ev" | grep -q Running || { echo "stand-in not running during the proof"; exit 1; }
echo ok
