#!/usr/bin/env bash
# scenario: workload-identity / A finished job pod holds nothing
# level: L2
# requirement: The secret store is a matched declared workload in the registration inventory
. "$EVAL_ROOT/evals/lib.sh"
ev=$(setup_file evidence/evidence.md); rc=$(cat "$(setup_file verify.rc)")
[ "$rc" = 0 ] || { echo "verify.sh failure count $rc"; exit 1; }
for p in 'ztd-mgmt/ztd-openbao-bootstrap-' 'ztd-mgmt/ztd-verify-openbao-'; do
  row=$(grep -F "\`$p" "$ev" | grep -F 'entry without a certificate in use' | head -1)
  echo "${p}*: ${row:0:200}"
  [ -n "$row" ] || { echo "no 'entry without a certificate in use' row for $p"; exit 1; }
done
# and neither is counted as unmatched
grep -F 'ztd-openbao-bootstrap-' "$ev" | grep -F '| not matched' && { echo "finished job pod reported as unmatched"; exit 1; }
echo ok
