#!/usr/bin/env bash
# scenario: workload-identity / The umbrella refuses a meshed zone without a trust domain
# level: L1
# requirement: The trust domain is the zone's delegated DNS name, one zone fact shared by SPIRE and the mesh
. "$(dirname "$0")/../lib.sh"
python3 - "$KIND_ZONE" "$EVAL_TMP/zone.yaml" <<'PY'
import sys, yaml
v = yaml.safe_load(open(sys.argv[1])); v["zone"].pop("trustDomain", None); v["mesh"]["mode"] = "sidecar"
yaml.safe_dump(v, open(sys.argv[2], "w"))
PY
out=$(helm template ztd "$ZTD_CHART" -n ztd-system -f "$EVAL_TMP/zone.yaml" 2>&1); rc=$?
echo "helm template, mesh.mode=sidecar, no zone.trustDomain: exit $rc"; grep -i 'error\|trustDomain' <<<"$out" | head -6
[ $rc -ne 0 ] || { echo "FAIL: rendering succeeded"; exit 1; }
grep -qi 'schema' <<<"$out" || { echo "FAIL: not a schema failure"; exit 1; }
grep -q 'trustDomain' <<<"$out" || { echo "FAIL: message does not name zone.trustDomain"; exit 1; }
echo "PASS"
