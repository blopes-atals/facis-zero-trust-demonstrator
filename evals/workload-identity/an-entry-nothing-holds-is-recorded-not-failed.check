#!/usr/bin/env bash
# scenario: workload-identity / An entry nothing holds is recorded, not failed
# level: L1
# requirement: The proof records the registration inventory by SPIFFE ID
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

# Read literally per entry; one matched entry is kept in the zone, the unheld entries must still add no failure.
z = Zone(); z.namespace("data")
um = z.pod("data", "ok", sa="ok"); z.entry("/ns/data/sa/ok", um); z.cert("data", "ok", f"spiffe://{TD}/ns/data/sa/ok")
u1 = z.pod("data", "nocert", sa="nocert")
z.entry("/ns/data/sa/gone", "uid-of-a-deleted-pod")          # pod gone
z.entry("/ns/data/sa/nocert", u1)                            # pod runs, no certificate readable
rep, ch = z.run(); show(rep, ch)
for sa in ("gone", "nocert"):
    r = row(rep, f"/sa/{sa}`")
    expect(r and "entry without a certificate in use" in r[0], f"{sa}: outcome must be entry without a certificate in use")
expect(not failed(ch), f"failure count must be unchanged, got {len(failed(ch))}")
print("both entries recorded as without a certificate in use, 0 failures")
PYEOF
