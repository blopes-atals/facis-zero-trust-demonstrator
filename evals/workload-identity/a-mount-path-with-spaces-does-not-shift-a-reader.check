#!/usr/bin/env bash
# scenario: workload-identity / A mount path with spaces does not shift a reader
# level: L1
# requirement: No pod escapes the certificate read by being deleted or by its own data
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
export V="$EVAL_ROOT/scripts/verify-mesh-identity/verify.sh"
exec python3 - <<'PYEOF'
import json, os, re, subprocess, sys, tempfile
from inv_lib import expect, Zone, show, failed
V = os.environ["V"]; src = open(V).read()
m = re.search(r"python3 - \"\$inv/namespaces.json\" \"\$inv/pods.json\"[^\n]*<<'PY'\n(.*?)\nPY\n", src, re.S)
expect(m, "cannot locate the reader listing in verify.sh")
loop = re.search(r'(: >"\$inv/certs.tsv"\n.*?\ndone <"\$inv/readers.txt")', src, re.S)
expect(loop, "cannot locate the read loop in verify.sh")
d = tempfile.mkdtemp(dir=os.environ.get("EVAL_TMP"))
PATHS = ["/var/run/my dir/sock et", "/a\tb/c"]
pods = []
for i, mp in enumerate(PATHS):
    pods.append({"metadata": {"namespace": "data", "name": f"p{i}", "uid": f"u{i}"},
      "spec": {"containers": [{"name": "c", "image": "spire-agent:1", "volumeMounts": [{"name": "s", "mountPath": mp}]}],
               "volumes": [{"name": "s", "csi": {"driver": "csi.spiffe.io"}}]},
      "status": {"phase": "Running", "containerStatuses": [{"name": "c", "state": {"running": {}}}]}})
json.dump({"items": [{"metadata": {"name": "data", "labels": {"ztd.facis.io/plane": "data"}}}]}, open(d + "/namespaces.json", "w"))
json.dump({"items": pods}, open(d + "/pods.json", "w"))
open(d + "/l.py", "w").write(m.group(1))
r = subprocess.run([sys.executable, d + "/l.py", d + "/namespaces.json", d + "/pods.json"], capture_output=True, text=True)
open(d + "/readers.txt", "w").write(r.stdout)
lines = r.stdout.splitlines()
expect(len(lines) == len(PATHS), f"one reader line per pod expected, got {lines!r}")
expect(all(len(l.split("\t")) == 7 for l in lines), f"each reader line must have 7 fields: {lines!r}")
# run the read loop with stubs recording the dir it is given and failing the read
open(d + "/loop.sh", "w").write(r'''
inv="$1"; : >"$inv/seen"
socket_cert() { printf '%s\n' "$4" >>"$inv/seen"; echo "dial failed" >"$5.err"; return 2; }
proxy_cert() { return 2; }
pod_gone() { return 1; }
reader_ended() { return 1; }
cert_uri() { :; }
''' + loop.group(1) + "\n")
subprocess.run(["bash", d + "/loop.sh", d], capture_output=True, text=True, env={**os.environ})
seen = open(d + "/seen").read().split("\n")[:-1]
print("socket_cert dirs:", seen)
expect(seen == PATHS, f"read must be attempted at the exact mount path: expected {PATHS!r}, got {seen!r}")
tsv = [l.split("\t") for l in open(d + "/certs.tsv").read().splitlines()]
expect(len(tsv) == len(PATHS) and all(x[3] == "error" and "dial failed" in x[7] for x in tsv), f"reads must be recorded failed with error: {tsv}")
# the record
z = Zone(); z.namespace("data")
u = z.pod("data", "p", sa="p"); z.entry("/ns/data/sa/p", u)
z.cert("data", "p", reader="socket", status="error", err="dial failed")
rep, ch = z.run(); show(rep, ch)
expect(failed(ch) and "read failed" in rep and "dial failed" in rep, "failed read must be printed and counted")
print("mount paths with spaces/tabs read at exact path, failed read fails the run")
PYEOF
