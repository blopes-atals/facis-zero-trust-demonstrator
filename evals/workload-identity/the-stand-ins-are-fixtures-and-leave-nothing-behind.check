#!/usr/bin/env bash
# scenario: workload-identity / The stand-ins are fixtures and leave nothing behind
# level: L1
# requirement: Every SPIFFE certificate in use in the zone has its entry and sits in a plane namespace
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

z = Zone(); z.namespace("data")
u = z.pod("data", "peer", sa="stand-in"); z.fixtures.append("data/peer")
z.entry("/ns/data/sa/stand-in", u); z.cert("data", "peer", f"spiffe://{TD}/ns/data/sa/stand-in")
rep, ch = z.run(); show(rep, ch)
r = row(rep, "/ns/data/sa/stand-in")
expect(r and all("matched" in x and x.rstrip().endswith("fixture |") for x in r), f"stand-in rows must be matched and marked fixture: {r}")
expect(not failed(ch), "no failure expected")
# kept zone: the record of what remains lists no stand-in entry and no stand-in certificate
src = open(VERIFY).read()
expect("stand-in entries: ${entries:-none}" in src and "stand-in certificates: ${certs_left:-none}" in src,
       "record of what remains must carry both stand-in entries and stand-in certificates")
print("stand-ins matched and marked fixture; remains record carries both stand-in lists")
PYEOF
