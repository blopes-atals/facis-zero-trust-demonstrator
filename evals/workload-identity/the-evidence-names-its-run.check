#!/usr/bin/env bash
# scenario: workload-identity / The evidence names its run
# level: L1
# requirement: The SVID evidence names its run and is written only by the script
. "$(dirname "$0")/../lib.sh"
f=$REPO/docs/evidences/mesh-identity/environment.json
rc=0
chk() { local v; v=$(jq -r "$2 // empty" "$f"); if [ -n "$v" ] && [ "$v" != null ]; then echo "PASS: $1 = $v"; else echo "FAIL: $1 missing ($2)"; rc=1; fi; }
chk commit .commit
c=$(jq -r .commit "$f"); git -C "$REPO" cat-file -e "$c^{commit}" 2>/dev/null || { echo "FAIL: commit $c not in the repository"; rc=1; }
[ "$(jq -r .dirty "$f")" = false ] && echo "PASS: dirty = false" || { echo "FAIL: dirty is not false"; rc=1; }
chk date .date
jq -r .date "$f" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T' || { echo "FAIL: date not ISO 8601"; rc=1; }
for t in kind kubectl helm istioctl cilium; do chk "tool $t" ".tools.\"$t\""; done
for c in spire-crds spire istio-base istiod istio-cni; do chk "chart $c" ".charts.\"$c\""; done
chk "host kind" '.host.kind'
exit $rc
