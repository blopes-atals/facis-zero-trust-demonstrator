#!/usr/bin/env bash
# scenario: workload-identity / A failed read whose pod cannot be looked up still fails the run
# level: L1
# requirement: A certificate the proof cannot read fails the run
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
fn=$(sed -n '/^pod_gone() {/,/^}/p' "$EVAL_ROOT/scripts/verify-mesh-identity/verify.sh")
[ -n "$fn" ] || { echo "pod_gone not found in verify.sh"; exit 1; }
rc=$(bash -c "k() { return 1; }; $fn; pod_gone data p uid-1; echo \$?" 2>/dev/null | tail -1)
[ "$rc" = 1 ] || { echo "FAIL: failed lookup must not be taken for gone (pod_gone rc $rc)"; exit 1; }
echo "ok failed lookup -> not gone (rc 1)"
python3 - <<'PYEOF'
from inv_lib import *
z = Zone(); z.namespace("data")
u = z.pod("data", "p", sa="p"); z.entry("/ns/data/sa/p", u)
z.cert("data", "p", status="error", err="exec failed; lookup failed too")
rep, ch = z.run(); show(rep, ch)
expect(failed(ch), "failed read with failed lookup must add a failure")
expect("read failed" in rep and "lookup failed too" in rep, "record must print the read as failed with its error")
print("failed read stays a failure")
PYEOF
