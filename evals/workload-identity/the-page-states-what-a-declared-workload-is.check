#!/usr/bin/env bash
# scenario: workload-identity / The page states what a declared workload is
# level: L1
# requirement: The identity path is documented
f="$EVAL_ROOT/docs/workload-identity.md"
sec=$(awk '/^## Registration/{p=1;next} /^## /{p=0} p' "$f" | tr '\n' ' ' | tr -s ' ')
[ -n "$sec" ] || { echo "no Registration section"; exit 1; }
rc=0
need() { grep -Eqi "$1" <<<"$sec" || { echo "MISSING: $2"; rc=1; }; }
need 'declared workload.{0,40}holds a SPIFFE certificate.{0,60}runs in a plane namespace' "declared workload = holds a SPIFFE certificate and runs in a plane namespace"
need 'inventory[^.]{0,40}(is )?the set of (registration )?entries on the SPIRE server' "inventory = set of entries on the server"
need 'nothing is declared by a written list or by what the charts render' "nothing declared by a written list or by what the charts render"
for o in 'matched' 'entry without a certificate in use' 'entry outside a plane namespace' 'not created by the registration rule'; do
  need "$o" "outcome '$o'"
done
[ $rc -eq 0 ] && echo "Registration section states the definition, the inventory, the no-list rule and the outcomes"
exit $rc
