#!/usr/bin/env bash
# scenario: workload-identity / No hook creates entries
# level: L1
# requirement: Registration is by selector, switched by the identity label, and never a hook
. "$(dirname "$0")/../lib.sh"
C=$REPO/deployment/helm/zone-policy
helm template zone-policy "$C" -n istio-system -f "$C/ci/values.yaml" > "$EVAL_TMP/zp.yaml" 2>&1 || { echo "FAIL: render"; exit 1; }
python3 - "$EVAL_TMP/zp.yaml" <<'PY' || exit 1
import sys, yaml
docs = [x for x in yaml.safe_load_all(open(sys.argv[1])) if x]
c = [x for x in docs if x["kind"] == "ClusterSPIFFEID"]
hooked = [x["metadata"]["name"] for x in c if "helm.sh/hook" in (x["metadata"].get("annotations") or {})]
print(f"rendered ClusterSPIFFEIDs: {[x['metadata']['name'] for x in c]}; with helm.sh/hook: {hooked}")
sys.exit(1 if hooked or not c else 0)
PY
bad=0
for f in $(grep -l 'kind: *ClusterSPIFFEID' "$C"/templates/* 2>/dev/null); do
  if grep -q 'helm.sh/hook' "$f"; then echo "FAIL: template $f carries helm.sh/hook"; bad=1; else echo "template $(basename "$f"): no helm.sh/hook"; fi
done
exit $bad
