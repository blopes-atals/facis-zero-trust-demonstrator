#!/usr/bin/env bash
# scenario: workload-identity / An entry whose namespace cannot be told is not created by the rule
# level: L1
# requirement: Every entry on the server was created by the registration rule
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

z = Zone(); z.namespace("data")
# no pod selector, no namespace selector, ID not of the shape /ns/<ns>/sa/<sa>
z.entry("/workload/odd", selectors=[{"type": "unix", "value": "uid:0"}])
rep, ch = z.run(); show(rep, ch)
r = row(rep, "/workload/odd")
expect(r and "not created by the registration rule" in r[0], f"must be not created by the registration rule: {r}")
expect("entry outside a plane namespace" not in r[0], "must not be reported as outside a plane namespace")
f = failed(ch)
expect(f, "failure count must increase")
expect(not any("outside a plane namespace" in c["title"] for c in f), "no 'outside a plane namespace' failure for it")
print("reported as not created by the rule, with a failure")
PYEOF
