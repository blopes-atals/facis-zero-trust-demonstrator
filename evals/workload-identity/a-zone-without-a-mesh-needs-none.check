#!/usr/bin/env bash
# scenario: workload-identity / A zone without a mesh needs none
# level: L1
# requirement: The trust domain is the zone's delegated DNS name, one zone fact shared by SPIRE and the mesh
. "$(dirname "$0")/../lib.sh"
z=$ZTD_CHART/zones/ionos.yaml
td=$(python3 -c 'import sys,yaml; v=yaml.safe_load(open(sys.argv[1])); print((v.get("zone") or {}).get("trustDomain","<absent>"), (v.get("mesh") or {}).get("mode"))' "$z")
echo "ionos.yaml: trustDomain mesh.mode = $td"
case $td in "<absent> "*|" "*) ;; *) echo "FAIL: ionos.yaml carries a trust domain"; exit 1;; esac
out=$(helm template ztd "$ZTD_CHART" -n ztd-system -f "$z" 2>&1); rc=$?
echo "helm template with zones/ionos.yaml: exit $rc"; [ $rc -eq 0 ] || { echo "$out" | tail -5; exit 1; }
echo "PASS: renders $(grep -c '^kind:' <<<"$out") objects without a trust domain"
