#!/usr/bin/env bash
# scenario: workload-identity / A pod without the label gets none
# level: L2
# requirement: Registration is by selector, switched by the identity label, and never a hook
. "$(dirname "$0")/../lib.sh"
need_live
rc=0
spire_server entry show -output json > "$EVAL_TMP/e.json" || { echo "FAIL: entry show"; exit 1; }
for p in ev-nosidecar ev-unlabelled; do
  uid=$(k -n "$DATA" get pod "$p" -o jsonpath='{.metadata.uid}')
  n=$(jq --arg u "$uid" --arg sa "/ns/$DATA/sa/$p" '[.entries[] | select(any(.selectors[]; .value == "pod-uid:\($u)") or .spiffe_id.path == $sa)] | length' "$EVAL_TMP/e.json")
  echo "$p (no identity label, $DATA): entries $n"; [ "$n" = 0 ] || rc=1
done
out=$(fetch_svid "$DATA" ev-nosidecar 2>&1); r=$?
echo "fetch over the mounted socket from ev-nosidecar: exit $r: $(head -c 200 <<<"$out")"
if [ $r -ne 0 ] && ! grep -q spiffe:// <<<"$out"; then echo "PASS: no SVID"; else echo "FAIL: an SVID was returned"; rc=1; fi
exit $rc
