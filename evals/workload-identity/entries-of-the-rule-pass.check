#!/usr/bin/env bash
# scenario: workload-identity / Entries of the rule pass
# level: L1
# requirement: Every entry on the server was created by the registration rule
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - <<'PYEOF'
from inv_lib import *

z = Zone(); z.namespace("data"); z.namespace("mgmt")
for ns, name, sa in (("data", "a", "sa-a"), ("mgmt", "b", "sa-b")):
    u = z.pod(ns, name, sa=sa); z.entry(f"/ns/{ns}/sa/{sa}", u); z.cert(ns, name, f"spiffe://{TD}/ns/{ns}/sa/{sa}")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), "no failure expected")
expect(any("created by the registration rule" in c["title"] and c["ok"] for c in ch), "a passing check that every entry was created by the rule is expected")
expect("0 not created by the registration rule" in rep, "summary must count 0 not created by the rule")
print("all entries created by the rule, no failure")
PYEOF
