#!/usr/bin/env bash
# scenario: workload-identity / A pod deleted after the listing is gone, not a failed read
# level: L1
# requirement: A certificate the proof cannot read fails the run
export PYTHONPATH="$(dirname "$0")${PYTHONPATH:+:$PYTHONPATH}"
# Part 1: the recheck (pod_gone from verify.sh) with a stubbed kubectl wrapper `k`
fn=$(sed -n '/^pod_gone() {/,/^}/p' "$EVAL_ROOT/scripts/verify-mesh-identity/verify.sh")
[ -n "$fn" ] || { echo "pod_gone not found in verify.sh"; exit 1; }
t() { # <stub body> <expected rc> <label>
  rc=$(bash -c "k() { $1; }; $fn; pod_gone data p uid-1; echo \$?" 2>/dev/null | tail -1)
  [ "$rc" = "$2" ] || { echo "FAIL $3: expected pod_gone rc $2, got $rc"; exit 1; }
  echo "ok $3 (rc $rc)"
}
t 'return 0' 0 "pod not found (empty uid) -> gone"
t 'echo uid-2' 0 "name belongs to another uid -> gone"
t 'echo uid-1' 1 "same uid -> still exists, read stands"
# Part 2: the record
python3 - <<'PYEOF'
from inv_lib import *
z = Zone(); z.namespace("data")
u = z.pod("data", "p", sa="p"); z.entry("/ns/data/sa/p", u)
z.cert("data", "p", status="gone")
rep, ch = z.run(); show(rep, ch)
expect(not failed(ch), "a pod gone since the listing must add no failure")
r = row(rep, "/ns/data/sa/p`")
expect(r and "entry without a certificate in use" in r[0], f"entry must read 'entry without a certificate in use': {r}")
expect("gone" in r[0], f"record must say the pod is gone: {r}")
expect("read failed" not in rep, "must not print a failed read")
print("gone pod: entry without a certificate in use, no failure")
PYEOF
