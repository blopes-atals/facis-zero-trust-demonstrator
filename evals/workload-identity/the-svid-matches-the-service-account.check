#!/usr/bin/env bash
# scenario: workload-identity / The SVID matches the service account
# level: L2
# requirement: A workload's SVID is proven over the CSI socket
. "$(dirname "$0")/../lib.sh"
need_live
T=$EVAL_TMP; rc=0
fetch_svid "$DATA" ev-client > "$T/svid.json" || { echo "FAIL: no SVID over the socket"; exit 1; }
id=$(jq -r '.svids[0].spiffe_id' "$T/svid.json"); want="spiffe://$TD_KIND/ns/$DATA/sa/$(k -n "$DATA" get pod ev-client -o jsonpath='{.spec.serviceAccountName}')"
echo "SVID over the CSI socket: $id"
[ "$id" = "$want" ] && echo "PASS: SPIFFE ID of the service account in the zone's trust domain" || { echo "FAIL: want $want"; rc=1; }
jq -r '.svids[0].x509_svid' "$T/svid.json" | base64 -d | openssl x509 -inform DER -out "$T/leaf.pem" 2>/dev/null
spire_bundle_pem > "$T/bundle.pem"
iss=$(openssl x509 -in "$T/leaf.pem" -noout -issuer -nameopt RFC2253 | sed 's/^issuer=//'); ca=$(openssl x509 -in "$T/bundle.pem" -noout -subject -nameopt RFC2253 | sed 's/^subject=//')
echo "issuer: $iss; SPIRE server CA: $ca"
[ "$iss" = "$ca" ] && openssl verify -CAfile "$T/bundle.pem" "$T/leaf.pem" >/dev/null 2>&1 && echo "PASS: issued by the SPIRE server CA" || { echo "FAIL"; rc=1; }
evidence_section_passed svid-over-csi-socket || { echo "FAIL: the proof's evidence does not show it"; rc=1; }
exit $rc
