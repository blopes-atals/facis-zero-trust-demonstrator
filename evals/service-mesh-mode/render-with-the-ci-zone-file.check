#!/usr/bin/env bash
# scenario: service-mesh-mode / Render with the CI zone file
# level: L1
# requirement: The umbrella chart default follows the recorded mode
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
command -v helm >/dev/null || unverifiable "helm not installed"
default=$(python3 -c 'import sys,yaml; print(yaml.safe_load(open(sys.argv[1]))["mesh"]["mode"])' "$EVAL_ROOT/deployment/helm/ztd/values.yaml")
echo "values.yaml mesh.mode default: $default"; [ "$default" = sidecar ] || fail "default mesh.mode is '$default', expected sidecar"
render_chart > "$EVAL_TMP/out.yaml" 2> "$EVAL_TMP/err" || { cat "$EVAL_TMP/err"; fail "helm template with ci/values.yaml failed"; }
bad=0
for ns in $(plane_namespaces); do
  labels=$(ns_labels "$EVAL_TMP/out.yaml" "$ns"); echo "namespace $ns labels:"; sed 's/^/  /' <<<"$labels"
  grep -qx 'istio-injection=enabled' <<<"$labels" || { echo "  -> missing istio-injection=enabled"; bad=1; }
  grep -q '^istio.io/dataplane-mode=' <<<"$labels" && { echo "  -> carries istio.io/dataplane-mode"; bad=1; }
done
n=$(kinds_of "$EVAL_TMP/out.yaml" | grep -c '^CiliumClusterwideNetworkPolicy$'); echo "CiliumClusterwideNetworkPolicy rendered: $n (expected 0)"
[ "$n" -eq 0 ] || bad=1
[ $bad -eq 0 ] || fail "sidecar default render does not match the spec"
