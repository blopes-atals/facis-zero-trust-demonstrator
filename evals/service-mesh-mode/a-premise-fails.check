#!/usr/bin/env bash
# scenario: service-mesh-mode / A premise fails
# level: L1
# requirement: The upstream state behind the decision is recorded by a script
# Three offline variants built from fixtures: the statement gone, a client PR merged, the Broker
# API outside the experimental block. Each must exit non-zero and name the condition that moved.
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
script=$(ls "$EVAL_ROOT"/scripts/mesh-mode/*.sh 2>/dev/null | head -1); [ -n "$script" ] || fail "no script under scripts/mesh-mode/"
FX="$EVAL_ROOT/evals/service-mesh-mode/fixtures/upstream"
run() { # run <name> <fixture dir> <migrate url> -> sets rc, log
  local name=$1 fx=$2 url=$3; local out="$EVAL_TMP/$name/out"; mkdir -p "$out"
  env -u CI OUT_DIR="$out" GITHUB_API="file://$fx/api" ISTIO_MIGRATE_URL="$url" SPIRE_DOC_BASE="file://$fx/spire" \
    bash "$script" > "$EVAL_TMP/$name/log" 2>&1; rc=$?
  log=$(cat "$EVAL_TMP/$name/log" "$out"/*.md 2>/dev/null)
  echo "== $name: exit $rc"; sed 's/^/   | /' "$EVAL_TMP/$name/log"
}
bad=0
expect_moved() { # expect_moved <name> <regex naming the moved condition>
  if [ "$rc" -eq 0 ]; then echo "   -> exited 0, expected non-zero"; bad=1; fi
  if grep -qiE 'unreachable' "$EVAL_TMP/$1/log"; then echo "   -> reported a fixture as unreachable; the fixture, not the product, may be wrong"; bad=1; fi
  if grep -qiE -- "$2" <<<"$log"; then echo "   -> names the moved condition (/$2/)"; else echo "   -> does NOT name the moved condition (/$2/)"; bad=1; fi
}
# 0. sanity: the fixture in the holding state exits 0 (otherwise the variants prove nothing)
"$FX/build.sh" "$EVAL_TMP/hold/fx" >/dev/null; run hold "$EVAL_TMP/hold/fx" "file://$EVAL_TMP/hold/fx/migrate.html"
[ "$rc" -eq 0 ] || fail "fixture sanity: the holding state exits $rc, not 0; the offline fixture does not reproduce the premises"
# A. the migration guide no longer contains the unsupported statement
"$FX/build.sh" "$EVAL_TMP/a/fx" >/dev/null; run a "$EVAL_TMP/a/fx" "file://$FX/migrate-without-statement.html"
expect_moved a 'istio|migration guide|unsupported|statement|condition 1'
# B. a ztunnel client pull request shows as merged
"$FX/build.sh" "$EVAL_TMP/b/fx" >/dev/null
sed -i 's/"merged_at":null,"merged":false/"merged_at":"2026-10-01T00:00:00Z","merged":true/; s/"state":"open"/"state":"closed"/' "$EVAL_TMP/b/fx/api/repos/istio/ztunnel/pulls/1936"
run b "$EVAL_TMP/b/fx" "file://$EVAL_TMP/b/fx/migrate.html"
expect_moved b '1936|broker api client|merged'
# C. the Broker API is no longer under the experimental block: move the broker row from the
#    `experimental` table into the main configuration table of the SPIRE agent document
"$FX/build.sh" "$EVAL_TMP/c/fx" >/dev/null
doc="$EVAL_TMP/c/fx/spire/v1.15.3/doc/spire_agent.md"
row=$(grep -E '^\| `broker`' "$doc" | head -1); [ -n "$row" ] || fail "fixture: no broker row in the SPIRE doc copy"
python3 - "$doc" "$row" <<'PY'
import sys
path, row = sys.argv[1], sys.argv[2]
lines = open(path).read().split("\n")
lines = [l for l in lines if l != row]
# insert it into the first table (the main agent configuration table), after its header separator
for i, l in enumerate(lines):
    if l.startswith("| :---") or l.startswith("|---") or l.startswith("| ---"):
        lines.insert(i + 1, row); break
open(path, "w").write("\n".join(lines))
PY
grep -n '^| `broker`' "$doc" | head -2
run c "$EVAL_TMP/c/fx" "file://$EVAL_TMP/c/fx/migrate.html"
expect_moved c 'spire|broker api|experimental|condition 2'
[ $bad -eq 0 ] || fail "a moved premise is not reported as the spec requires"
