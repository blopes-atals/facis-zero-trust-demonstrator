#!/usr/bin/env bash
# scenario: service-mesh-mode / The failure paths run in CI without writing evidence
# level: L2
# requirement: The upstream state behind the decision is recorded by a script
cd "$EVAL_ROOT" || exit 1
t=scripts/mesh-mode/check-upstream-state-test.sh
[ -x "$t" ] || { echo "FAIL: $t missing or not executable"; exit 1; }
grep -qF "$t" .github/workflows/ci.yml || { echo "FAIL: CI does not run $t"; exit 1; }
d=docs/evidences/mesh-mode-upstream-state
before_status=$(git status --porcelain -- "$d"); before_hash=$(find "$d" -type f -exec sha256sum {} + | sort)
# run as CI does: CI set, ALLOW_CI=1, no OUT_DIR given (the test must pick a temporary one)
env -u OUT_DIR CI=true ALLOW_CI=1 TMPDIR="$EVAL_TMP" HOME="$EVAL_TMP" timeout 170 "$t" >"$EVAL_TMP/out" 2>&1; rc=$?
tail -40 "$EVAL_TMP/out"
fail=0
[ $rc -eq 0 ] || { echo "FAIL: the test exited $rc"; fail=1; }
[ "$(git status --porcelain -- "$d")" = "$before_status" ] || { echo "FAIL: git status of $d changed"; fail=1; }
[ "$(find "$d" -type f -exec sha256sum {} + | sort)" = "$before_hash" ] || { echo "FAIL: files under $d changed"; fail=1; }
[ -z "$(git status --porcelain -- "$d")" ] || echo "note: $d was already dirty before the run"
exit $fail
