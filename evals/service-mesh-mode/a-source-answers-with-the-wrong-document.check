#!/usr/bin/env bash
# scenario: service-mesh-mode / A source answers with the wrong document
# level: L2
# requirement: The upstream state behind the decision is recorded by a script
. "$EVAL_ROOT/evals/service-mesh-mode/_lib.sh"
standins_hold; start_standin
fail=0
judge() { # judge <case> <regex for the source> <expected shape string>
  local rec; rec=$(record)
  [ $rc -eq 2 ] || { echo "FAIL($1): expected the unreachable status 2, got $rc"; fail=1; }
  grep -iE "UNREACHABLE.*($2)" <<<"$rec" | grep -qF -- "$3" \
    || { echo "FAIL($1): the record does not list the source as unreachable with the expected shape \"$3\""; fail=1; }
  grep -qiE 'not documented' <<<"$rec" && { echo "FAIL($1): the record says the Broker API is not documented"; fail=1; }
  grep -qiE 'no longer contains' <<<"$rec" && { echo "FAIL($1): the record claims the statement is absent"; fail=1; }
  echo "-- record UNREACHABLE lines:"; grep -i 'UNREACHABLE' <<<"$rec"
}
cp "$DOCROOT/istio/migrate.html" "$EVAL_TMP/migrate.orig"
cat >"$DOCROOT/istio/migrate.html" <<'HTML'
<!doctype html><html><head><title>Istio / Page not found</title></head><body><h1>Page not found</h1></body></html>
HTML
run_checker; judge guide-wrong 'migration guide' 'Migrate from Sidecar to Ambient'
cp "$EVAL_TMP/migrate.orig" "$DOCROOT/istio/migrate.html"
printf '# SPIRE Server Configuration Reference\n\nSomething else entirely.\n' >"$DOCROOT/spire/$SPIRE_TAG/doc/spire_agent.md"
run_checker; judge spire-wrong 'SPIRE agent' '# SPIRE Agent Configuration Reference'
exit $fail
