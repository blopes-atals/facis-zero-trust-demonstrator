#!/usr/bin/env bash
# scenario: service-mesh-mode / The page cannot be fetched
# level: L1
# requirement: The upstream state behind the decision is recorded by a script
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
script=$(ls "$EVAL_ROOT"/scripts/mesh-mode/*.sh 2>/dev/null | head -1); [ -n "$script" ] || fail "no script under scripts/mesh-mode/"
FX="$EVAL_ROOT/evals/service-mesh-mode/fixtures/upstream"
"$FX/build.sh" "$EVAL_TMP/fx" >/dev/null
out="$EVAL_TMP/out"; mkdir -p "$out"
# every source reachable except the migration guide
env -u CI OUT_DIR="$out" GITHUB_API="file://$EVAL_TMP/fx/api" ISTIO_MIGRATE_URL="file://$EVAL_TMP/fx/does-not-exist.html" SPIRE_DOC_BASE="file://$EVAL_TMP/fx/spire" \
  bash "$script" > "$EVAL_TMP/log" 2>&1; rc=$?
echo "exit: $rc (expected non-zero)"; sed 's/^/   | /' "$EVAL_TMP/log"
all=$(cat "$EVAL_TMP/log" "$out"/*.md 2>/dev/null)
bad=0
[ $rc -ne 0 ] || { echo "-> exited 0"; bad=1; }
grep -qiE 'unreachable|could not (be )?fetch|cannot (be )?fetch|failed to fetch|not reachable' <<<"$all" && echo "-> reports a source as unreachable" || { echo "-> does not report the source as unreachable"; bad=1; }
grep -iE 'unreachable|could not (be )?fetch|cannot (be )?fetch|failed to fetch|not reachable' <<<"$all" | grep -qiE 'migrat|istio' && echo "-> names the migration guide" || { echo "-> does not name the migration guide as the unreachable source"; bad=1; }
claims=$(grep -iE 'no longer contain|statement.*(absent|not found|gone|missing)|(absent|not found|gone|missing).*statement|condition 1.*moved' <<<"$all" | grep -viE 'unreachable|claims nothing|not claimed|cannot (say|tell|judge)|unknown' || true)
if [ -n "$claims" ]; then echo "-> CLAIMS the statement is absent:"; echo "$claims"; bad=1; else echo "-> does not claim the statement is absent"; fi
[ $bad -eq 0 ] || fail "unreachable source not handled as the spec requires"
