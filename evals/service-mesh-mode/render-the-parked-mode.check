#!/usr/bin/env bash
# scenario: service-mesh-mode / Render the parked mode
# level: L1
# requirement: The ambient mode stays available but unused
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
command -v helm >/dev/null || unverifiable "helm not installed"
render_chart --set mesh.mode=ambient > "$EVAL_TMP/out.yaml" 2> "$EVAL_TMP/err" || { cat "$EVAL_TMP/err"; fail "helm template --set mesh.mode=ambient failed (schema no longer accepts ambient?)"; }
bad=0
for ns in $(plane_namespaces); do
  labels=$(ns_labels "$EVAL_TMP/out.yaml" "$ns"); echo "namespace $ns labels:"; sed 's/^/  /' <<<"$labels"
  grep -qx 'istio.io/dataplane-mode=ambient' <<<"$labels" || { echo "  -> missing istio.io/dataplane-mode=ambient"; bad=1; }
done
n=$(kinds_of "$EVAL_TMP/out.yaml" | grep -c '^CiliumClusterwideNetworkPolicy$'); echo "CiliumClusterwideNetworkPolicy rendered: $n (expected >= 1)"
[ "$n" -ge 1 ] || bad=1
[ $bad -eq 0 ] || fail "ambient render does not match the spec"
