#!/usr/bin/env bash
# scenario: service-mesh-mode / Only one condition is met
# level: L1
# requirement: The reopen trigger is a double condition
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
rec=$(superseding_record) || fail "ADR-0001 does not point at an existing superseding record"
text=$(tr '\n' ' ' < "$rec")
missing=0
need() { local label=$1; shift; local ok=1 r; for r in "$@"; do grep -qiE -- "$r" <<<"$text" || { ok=0; echo "  missing /$r/"; }; done
  if [ $ok = 1 ]; then echo "present: $label"; else echo "ABSENT: $label"; missing=$((missing+1)); fi; }
need "condition 1: community Istio release, ztunnel gets workload certs from the SPIRE agent via the SPIFFE Broker API, supported in ambient" 'ztunnel' 'Broker API' 'community' 'ambient'
need "condition 2: SPIRE release with the Broker API stable outside the experimental block" 'experimental' 'stable|stabilis|stabiliz'
need "both must hold, in released versions" 'both' 'released? (version|in)|in released'
need "one condition without the other does not reopen it" 'one (condition )?(of (them|the two) )?(without|alone)|without the other|alone (does|is) not|neither (condition )?alone|not (reopened|enough|sufficient) (on its own|alone|by itself)'
need "a commercial distribution does not count" 'commercial' '(does|do) not count|not count|does not (qualify|satisfy|reopen)|is not (enough|sufficient)'
need "current state of each condition with version and date" 'istio ?1\.[0-9]+' '(spire|v)1\.[0-9]+\.[0-9]+' '20[0-9]{2}-[0-9]{2}-[0-9]{2}|[0-9]{1,2} (jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]* 20[0-9]{2}'
need "when the check is made" '(at|on|with|after|before) (every|each) [a-z ]*(upgrade|release|review)|quarterly|every (quarter|month|release)'
[ $missing -eq 0 ] || fail "$missing element(s) of the reopen trigger missing: a reviewer with only one condition met is not told the decision stays closed"
echo "the wording tells a reviewer that one condition alone (e.g. SPIRE stable, no Istio release) does not reopen the decision"
