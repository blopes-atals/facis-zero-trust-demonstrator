#!/usr/bin/env bash
# scenario: service-mesh-mode / The note is complete
# level: L1
# requirement: The security note names what the fallback changes
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
rec=$(superseding_record) || fail "ADR-0001 does not point at an existing superseding record"
# the security note: from a heading containing "security" to the next heading of the same or higher level
# (tolower, not IGNORECASE: the latter is gawk-only and silently ignored by mawk)
note=$(awk '/^#+ /{ if (p && length(lvl)>=length($1)) exit; if (tolower($0) ~ /security/) {p=1; lvl=$1} } p' "$rec")
[ -n "$note" ] || fail "no heading containing 'security' in $(basename "$rec")"
echo "security note: $(wc -l <<<"$note") lines"
missing=0
need() { # need <label> <regex...>: every regex must match the note (case-insensitive)
  local label=$1; shift; local ok=1 r
  for r in "$@"; do grep -qiE -- "$r" <<<"$note" || { ok=0; echo "  missing /$r/"; }; done
  if [ $ok = 1 ]; then echo "present: $label"; else echo "ABSENT: $label"; missing=$((missing+1)); fi
}
need "1. per-pod proxy surface, accepted because of per-pod identity and mTLS issued by SPIRE" 'per-pod' 'proxy|envoy|sidecar' 'mTLS' 'SPIRE'
need "2. sidecar owns L7 on a path, Cilium held to L3/L4, recorded per path, no path has two L7 owners" 'L3/L4' 'L7' 'per (traffic )?path|each path|every path' 'cilium'
need "2b. the L7 statement cites the SRS rule that both must not enforce L7 on the same path" 'SRS' 'both' 'not (be )?enforced|MUST NOT|simultaneous'
need "3. injection uses native sidecar containers, each cluster's Kubernetes version recorded" 'native sidecar' 'kubernetes' '1\.[0-9]{2}'
need "4. what advantage of ambient is given up and at what cost" 'ambient' 'give[sn]? up|given up|forgo|lose[sd]?|lost' 'cost'
[ $missing -eq 0 ] || fail "$missing point(s) of the security note missing"
