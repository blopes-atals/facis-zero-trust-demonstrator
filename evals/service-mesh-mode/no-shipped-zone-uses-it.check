#!/usr/bin/env bash
# scenario: service-mesh-mode / No shipped zone uses it
# level: L1
# requirement: The ambient mode stays available but unused
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
cd "$EVAL_ROOT/deployment/helm/ztd" || exit 1
bad=0; n=0
for f in zones/*.yaml zones/*.yml ci/values.yaml; do
  [ -f "$f" ] || continue; n=$((n+1))
  mode=$(python3 -c 'import sys,yaml; v=yaml.safe_load(open(sys.argv[1])) or {}; print((v.get("mesh") or {}).get("mode","<unset>"))' "$f")
  echo "$f: mesh.mode=$mode"; [ "$mode" != ambient ] || bad=1
done
[ $n -gt 0 ] || fail "no zone files found"
[ $bad -eq 0 ] || fail "a shipped zone file sets mesh.mode: ambient"
