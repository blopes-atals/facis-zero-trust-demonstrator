#!/usr/bin/env bash
# scenario: service-mesh-mode / The index lists both records
# level: L1
# requirement: The mesh mode flip is recorded as a superseding decision record
set -u; . "$EVAL_ROOT/evals/service-mesh-mode/fixtures/lib.sh"
idx="$ADR_DIR/index.md"; [ -f "$idx" ] || fail "no $idx"
rec=$(superseding_record) || fail "ADR-0001 does not point at an existing superseding record"
recfile=$(basename "$rec"); recnum=${recfile%%-*}
status=$(grep -iE '^\**status' "$rec" | head -1 | sed -E 's/^[^:]*:\**//; s/\*//g' | awk '{print $1}')
[ -n "$status" ] || status=$(grep -ioE 'status[^a-z]*(proposed|accepted|draft)' "$rec" | head -1 | grep -ioE 'proposed|accepted|draft')
echo "superseding record $recfile, its own status: '${status:-?}'"
row=$(grep -E "$recfile|ADR-?$recnum|\b$recnum\b" "$idx" | head -3); [ -n "$row" ] || fail "index has no row for $recfile"
echo "index rows for $recnum:"; echo "$row"
[ -n "$status" ] && { grep -qi "$status" <<<"$row" || fail "the $recnum row does not show its status '$status'"; }
row1=$(grep -E '0001' "$idx" | head -3); [ -n "$row1" ] || fail "index has no row for 0001"
echo "index rows for 0001:"; echo "$row1"
grep -qiE 'superseded' <<<"$row1" || fail "the 0001 row does not show it as superseded"
echo "ok"
